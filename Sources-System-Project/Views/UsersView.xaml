<UserControl x:Class="Sources.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── الترويسة + زر إضافة ─── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="{DynamicResource BtnAddUser}" Style="{StaticResource PrimaryButton}" Command="{Binding AddNewCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="{StaticResource GoldColor}"/>
                </Button.Effect>
            </Button>
        </DockPanel>

        <!-- ─── بطاقات إحصائية ─── -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource DashboardStatCard}" BorderBrush="{StaticResource GoldBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUsersCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource UserStatsTotal}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardStatCard}" BorderBrush="{DynamicResource SuccessBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCheck" Width="32" Height="32" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveUsersCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource UserStatsActive}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardStatCard}" BorderBrush="{DynamicResource InfoBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldAccount" Width="32" Height="32" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AdminUsersCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource UserStatsAdmins}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ─── القسم الرئيسي: جدول المستخدمين أو النموذج ─── -->
        <Grid Grid.Row="2">
            <!-- جدول المستخدمين -->
            <Border Style="{StaticResource ContentCard}" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColFullName}" Binding="{Binding FullName}" Width="180"/>
                        <DataGridTextColumn Header="{DynamicResource ColUsername}" Binding="{Binding Username}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource ColRole}" Binding="{Binding Role.DisplayName}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource ColEmail}" Binding="{Binding Email}" Width="180"/>
                        <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,2" HorizontalAlignment="Center" MinWidth="75">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplayName}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="{DynamicResource CtxEdit}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="32" Height="32" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="{StaticResource GoldBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="{DynamicResource BtnToggleFreeze}"
                                                Command="{Binding DataContext.ToggleUserFreezeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <Grid>
                                                <!-- أيقونة تجميد (تظهر عندما الحساب نشط) -->
                                                <materialDesign:PackIcon Kind="AccountCancel" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"
                                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                <!-- أيقونة تنشيط (تظهر عندما الحساب مجمد) -->
                                                <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}"
                                                                         Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource CtxEdit}" Command="{Binding EditCommand}"/>
                            <MenuItem Header="{DynamicResource CtxDelete}" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>

            <!-- نموذج الإضافة/التعديل -->
            <Border Style="{StaticResource ContentCard}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <Border.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                </Border.InputBindings>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="{DynamicResource UserDataTitle}" Style="{StaticResource CardTitle}" FontSize="20" Margin="0,0,0,20"/>

                        <!-- البيانات الأساسية -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource FieldFullNameReq}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditFullName}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource FieldUsernameReq}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditUsername}" Style="{StaticResource FormTextBox}" IsEnabled="{Binding IsNew}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FieldPassword}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding EditPassword, Mode=TwoWay}" Style="{StaticResource FormPasswordBox}"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource FieldEmail}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditEmail}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FieldRoleReq}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding EditRoleId}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName" Style="{StaticResource FormComboBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <CheckBox Content="{DynamicResource FieldIsActive}" IsChecked="{Binding EditIsActive}" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox Content="{DynamicResource LabelIsEditor}" IsChecked="{Binding EditIsEditor}" Foreground="{DynamicResource TextPrimary}"/>
                        </UniformGrid>

                        <!-- قسم الصلاحيات (يظهر فقط لغير المدير) -->
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                                Visibility="{Binding IsPermissionsSectionVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="ShieldKey" Width="20" Height="20" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LabelPermissions}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Rows="4">
                                    <CheckBox Content="{DynamicResource PermRadioisotopes}" IsChecked="{Binding PermRadioisotopes}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermSources}" IsChecked="{Binding PermSources}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermLocations}" IsChecked="{Binding PermLocations}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermBorrowing}" IsChecked="{Binding PermBorrowing}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermReports}" IsChecked="{Binding PermReports}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermCalculator}" IsChecked="{Binding PermCalculator}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermUsers}" IsChecked="{Binding PermUsers}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                    <CheckBox Content="{DynamicResource PermSettings}" IsChecked="{Binding PermSettings}" Margin="0,4" Foreground="{DynamicResource TextPrimary}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="{DynamicResource BtnSave}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0,0,12,0"/>
                            <Button Content="{DynamicResource BtnCancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" IsCancel="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ─── سجل التدقيق ─── -->
        <Expander Grid.Row="3" Margin="0,8,0,0" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource TabAuditLog}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Expander.Header>
            <Border Style="{StaticResource ContentCard}">
                <DockPanel>
                    <!-- فلاتر -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource FilterByUser}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserFilter}" DisplayMemberPath="FullName"
                                      Width="180" Style="{StaticResource FormComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource FilterFromDate}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FilterStartDate}" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource FilterToDate}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate}" Width="150"/>
                        </StackPanel>
                        <Button Content="{DynamicResource BtnClearFilters}" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- إحصائيات سريعة -->
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
                        <Border Style="{StaticResource StatCard}" Padding="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarToday" Width="20" Height="20" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ActivitiesTodayCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource StatActivitiesToday}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Padding="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ModificationsTodayCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource StatModificationsToday}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Padding="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountStar" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding MostActiveUser}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource StatMostActiveUser}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- جدول السجل -->
                    <DataGrid ItemsSource="{Binding AuditLogs}" Style="{StaticResource ModernDataGrid}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColUser}" Binding="{Binding User.FullName}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource ColOperation}" Binding="{Binding Action}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource ColDetails}" Binding="{Binding Details}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource ColDate}" Binding="{Binding ActionDate, StringFormat=G}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
