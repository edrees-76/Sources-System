<UserControl x:Class="Sources.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Sources.Converters">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الجدول / أو نموذج التحرير -->
        <Grid Grid.Row="1">
            <!-- المشهد 1: صفحة قائمة المصادر والبحث (يختفي عند التحرير) -->
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Title & Actions -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Total Activity Stats (Sticky/Premium) -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Search & Filters -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Main Content (DataGrid/Pagination) -->
                </Grid.RowDefinitions>
                
                <!-- شريط العنوان والأزرار الأساسية مع التبويبات (Row 0) -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                    <!-- العنوان في اليمين -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Radioactive" Width="32" Height="32" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource SourcesManagementTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource SourcesManagementSubtitle}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- تبويبات التبديل بين المصادر النشطة والمصادر المحذوفة -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="4" Margin="24,0,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- تبويب المصادر النشطة -->
                            <Button Command="{Binding SwitchToActiveSourcesCommand}"
                                    Padding="14,6" Height="34" Margin="0,0,4,0"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeletedSourcesView}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Radioactive" Width="16" Height="16" Margin="-2,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource TabActiveSources}" VerticalAlignment="Center"/>
                                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding IsDeletedSourcesView, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding ActiveSourcesCount}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- تبويب المصادر المحذوفة -->
                            <Button Command="{Binding SwitchToDeletedSourcesCommand}"
                                    Padding="14,6" Height="34"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeletedSourcesView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" Margin="-2,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource TabDeletedSources}" VerticalAlignment="Center"/>
                                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding IsDeletedSourcesView, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DeletedSourcesCount}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- زر الإضافة في اليسار مع أزرار التصدير (تظهر فقط في مشهد المصادر النشطة) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsDeletedSourcesView, Converter={StaticResource InverseBoolToVis}}">
                        <Button Content="{DynamicResource BtnAddSource}" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding AddNewCommand}" Margin="0,0,8,0">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="{StaticResource GoldColor}"/>
                            </Button.Effect>
                        </Button>
                        
                        <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,8,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnExportPdf}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnExportExcel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- المشهد الفرعي 1: المصادر النشطة                    -->
                <!-- ══════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Grid.RowSpan="3"
                      Visibility="{Binding IsDeletedSourcesView, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Total Activity Stats -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Search & Filters -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Main Content Cards & Pagination -->
                    </Grid.RowDefinitions>

                    <!-- شريط إجمالي النشاط الإشعاعي (Row 0 - Premium Card) -->
                    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="20,12" Margin="0,0,0,16" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="0,0,4,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- التسمية والأيقونة -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LabelTotalActivityStats}" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- الوحدات المحولة -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TotalActivityItems}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GoldBrush}" CornerRadius="6" Padding="12,5" Margin="0,0,10,5">
                                            <TextBlock Text="{Binding DisplayValue}" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- شريط البحث والفلترة (Row 1) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <DockPanel>
                            <!-- أيقونة الفلترة -->
                            <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                            
                            <!-- صندوق البحث -->
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                      Style="{DynamicResource SearchBox}" materialDesign:HintAssist.Hint="{DynamicResource HintSearchSources}"
                                      DockPanel.Dock="Right" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GoldBrush}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            
                            <!-- زر البحث -->
                            <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{Binding Converter={StaticResource BoolToValue}, ConverterParameter='Search|بحث'}"
                                    DockPanel.Dock="Right" Margin="2,0,4,0" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                            </Button>

                            <!-- زر التحديث -->
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{DynamicResource ToolTipRefreshActivity}"
                                    DockPanel.Dock="Right" Margin="2,0,12,0" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Cached" Width="20" Height="20" Foreground="{DynamicResource GoldBrush}"/>
                            </Button>
                            
                            <!-- تصفية الحالة -->
                            <ComboBox SelectedValue="{Binding StatusFilter}" Width="160" Margin="0,0,16,0"
                                      Style="{DynamicResource FormComboBox}"
                                      materialDesign:HintAssist.Hint="{DynamicResource FilterAllStatuses}" DockPanel.Dock="Right">
                                <ComboBoxItem Content="{DynamicResource FilterAllStatuses}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource StatusInUse}" Tag="InUse"/>
                                <ComboBoxItem Content="{DynamicResource StatusStorage}" Tag="Storage"/>
                                <ComboBoxItem Content="{DynamicResource StatusWaste}" Tag="Waste"/>
                                <ComboBoxItem Content="{DynamicResource StatusTransfer}" Tag="Transfer"/>
                            </ComboBox>

                            <!-- زر إعادة التعيين -->
                            <Button Command="{Binding ResetSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    DockPanel.Dock="Right" Margin="0,0,12,0" Height="40" BorderBrush="{DynamicResource GoldBrush}" Foreground="{DynamicResource GoldBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource BtnReset}" Margin="4,0,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════ -->
                    <!-- منطقة البيانات الرئيسية (Row 2 – Hybrid Cards)   -->
                    <!-- ══════════════════════════════════════════════════ -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Row 0: رأس الأعمدة -->
                            <RowDefinition Height="*"/>     <!-- Row 1: قائمة البطاقات -->
                            <RowDefinition Height="Auto"/>  <!-- Row 2: شريط ترقيم الصفحات -->
                        </Grid.RowDefinitions>

                        <!-- ─── رأس الأعمدة (Header Row) ─── -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource DataGridHeader}"
                                CornerRadius="10,10,0,0"
                                Padding="12,10"
                                Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>      <!-- 0: # (رقم الصف) -->
                                    <ColumnDefinition Width="50"/>      <!-- 1: صورة -->
                                    <ColumnDefinition Width="105"/>     <!-- 2: كود المصدر -->
                                    <ColumnDefinition Width="105"/>     <!-- 3: التسلسل -->
                                    <ColumnDefinition Width="*"/>       <!-- 4: النظائر -->
                                    <ColumnDefinition Width="115"/>     <!-- 5: النشاط الحالي -->
                                    <ColumnDefinition Width="125"/>     <!-- 6: الموقع -->
                                    <ColumnDefinition Width="95"/>      <!-- 7: الحالة -->
                                    <ColumnDefinition Width="100"/>     <!-- 8: الإجراءات -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource ColSourceCode}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource ColSerialNumber}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource ColRadioisotopes}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{DynamicResource ColCurrentActivity}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{DynamicResource ColStorageLocation}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="{DynamicResource ColSourceStatus}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="{DynamicResource ColActions}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ─── قائمة البطاقات ─── -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- حالة فارغة: لا توجد مصادر -->
                                <Border Visibility="{Binding Sources.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                                        Background="{DynamicResource CardBackground}"
                                        CornerRadius="0,0,10,10"
                                        Padding="40,60">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- أيقونة كبيرة -->
                                        <Border Width="80" Height="80" CornerRadius="40"
                                                HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.12"/>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="RadioactiveCircleOutline"
                                                                     Width="44" Height="44"
                                                                     Foreground="{DynamicResource GoldBrush}"
                                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- نص الحالة الفارغة -->
                                        <TextBlock Text="{DynamicResource EmptySourcesTitle}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource EmptySourcesSubtitle}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="340"
                                                   Margin="0,0,0,24"/>
                                        <!-- زر الإضافة -->
                                        <Button Content="{DynamicResource BtnAddSource}"
                                                Command="{Binding AddNewCommand}"
                                                Style="{DynamicResource PrimaryButton}"
                                                HorizontalAlignment="Center"
                                                Width="200">
                                            <Button.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="{StaticResource PrimaryColor}"/>
                                            </Button.Effect>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- قائمة البطاقات الفعلية -->
                                <ItemsControl ItemsSource="{Binding PagedSources}"
                                              AlternationCount="1000"
                                              x:Name="SourceCardsPanel">
                                    <!-- عكس الظهور: نظهر ItemsControl فقط حين يكون Count != 0 -->
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- بطاقة المصدر الأفقية -->
                                            <Border x:Name="SourceCard" Style="{DynamicResource ModernCardListItemStyle}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>      <!-- 0: # (رقم الصف) -->
                                                        <ColumnDefinition Width="50"/>      <!-- 1: صورة المصدر -->
                                                        <ColumnDefinition Width="105"/>     <!-- 2: كود المصدر -->
                                                        <ColumnDefinition Width="105"/>     <!-- 3: الرقم التسلسلي -->
                                                        <ColumnDefinition Width="*"/>       <!-- 4: النظائر -->
                                                        <ColumnDefinition Width="115"/>     <!-- 5: النشاط الحالي -->
                                                        <ColumnDefinition Width="125"/>     <!-- 6: الموقع -->
                                                        <ColumnDefinition Width="95"/>      <!-- 7: شارة الحالة -->
                                                        <ColumnDefinition Width="100"/>     <!-- 8: الإجراءات -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ── عمود 0: رقم الصف (#) ── -->
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource RowIndexConverter}">
                                                                <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                                <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                <Binding Path="DataContext.PageSize" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <!-- ── عمود 1: صورة المصدر ── -->
                                                    <Border Grid.Column="1"
                                                            Width="40" Height="40"
                                                            CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource InputBackground}"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                        <Grid>
                                                            <materialDesign:PackIcon Kind="Radioactive"
                                                                                     Width="22" Height="22"
                                                                                     Foreground="{DynamicResource GoldBrush}"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                     Visibility="{Binding ImagePath, Converter={StaticResource NullToVis}, ConverterParameter='Inverse'}"/>
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource RelativePathToAbsolute}}"
                                                                   Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ── عمود 2: كود المصدر ── -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SourceCode}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- ── عمود 3: الرقم التسلسلي ── -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SerialNumber, TargetNullValue='-', FallbackValue='-'}"
                                                               FontSize="13"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- ── عمود 4: النظائر المشعة (شارات) ── -->
                                                    <ItemsControl Grid.Column="4"
                                                                  ItemsSource="{Binding DisplayIsotopesList}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource PrimaryBrush}"
                                                                        CornerRadius="10"
                                                                        Padding="8,3"
                                                                        Margin="2,2">
                                                                    <Border.Opacity>0.85</Border.Opacity>
                                                                    <TextBlock Text="{Binding}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               FontFamily="Segoe UI"
                                                                               Foreground="White"
                                                                               FlowDirection="LeftToRight"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- ── عمود 5: النشاط الحالي ومعدل الجرعة ── -->
                                                    <StackPanel Grid.Column="5"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextAlignment="Center"
                                                                   FlowDirection="LeftToRight">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} {1}">
                                                                    <Binding Path="CurrentActivityDisplay"/>
                                                                    <Binding Path="CurrentActivityUnit.UnitSymbol"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CalibrationDate, StringFormat=yyyy-MM-dd}"
                                                                   FontSize="10"
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   TextAlignment="Center"
                                                                   FlowDirection="LeftToRight"
                                                                   Margin="0,1,0,0"/>
                                                        <Border Background="#141F5A66" CornerRadius="4" Padding="5,1" Margin="0,2,0,0"
                                                                HorizontalAlignment="Center" ToolTip="{Binding DoseRateTooltip}">
                                                            <TextBlock Text="{Binding DisplayDoseRate}"
                                                                       FontSize="9.5" FontWeight="SemiBold"
                                                                       FontFamily="Segoe UI"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       TextAlignment="Center"
                                                                       FlowDirection="LeftToRight"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- ── عمود 6: الموقع ── -->
                                                    <StackPanel Grid.Column="6"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="MapMarkerOutline"
                                                                                 Width="14" Height="14"
                                                                                 Foreground="{DynamicResource TextSecondary}"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Location.LocationName}"
                                                                   FontSize="12"
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="105"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- ── عمود 7: شارة الحالة اللونية ── -->
                                                    <Border Grid.Column="7"
                                                            CornerRadius="12"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <!-- افتراضي: معلومات/رمادي -->
                                                                <Setter Property="Background" Value="#1A4F7FA3"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                        <Setter Property="Background" Value="#1A3FAE7A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                                        <Setter Property="Background" Value="#1A3FAE7A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Storage">
                                                                        <Setter Property="Background" Value="#1A4F7FA3"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Waste">
                                                                        <Setter Property="Background" Value="#1AE0A93E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Transfer">
                                                                        <Setter Property="Background" Value="#1AE0A93E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Decayed">
                                                                        <Setter Property="Background" Value="#1AC25B4A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Disposed">
                                                                        <Setter Property="Background" Value="#1AC25B4A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Lost">
                                                                        <Setter Property="Background" Value="#1AC25B4A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SimpleArabicStatus}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   FontFamily="Segoe UI"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Storage">
                                                                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Waste">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Transfer">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Decayed">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Disposed">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Lost">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- ── عمود 8: أزرار الإجراءات ── -->
                                                    <StackPanel Grid.Column="8"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <!-- عرض التفاصيل -->
                                                        <Button Command="{Binding DataContext.ViewSourceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                                Padding="4" Height="30" Width="30"
                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                ToolTip="{DynamicResource ToolTipViewDetails}">
                                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                        </Button>
                                                        <!-- تعديل -->
                                                        <Button Command="{Binding DataContext.EditSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                                Padding="4" Height="30" Width="30"
                                                                Foreground="{DynamicResource GoldBrush}"
                                                                ToolTip="{DynamicResource CtxEdit}">
                                                            <materialDesign:PackIcon Kind="Edit" Width="18" Height="18"/>
                                                        </Button>
                                                        <!-- حذف -->
                                                        <Button Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                                Padding="4" Height="30" Width="30"
                                                                Foreground="{DynamicResource DangerBrush}"
                                                                ToolTip="{DynamicResource CtxDelete}">
                                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                    <!-- ─── شريط ترقيم الصفحات ─── -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="0,0,10,10"
                            Padding="16,10"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="0,1,0,0"
                            Margin="0,6,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <!-- معلومات الصفحة -->
                            <TextBlock Text="{Binding PageStatusText}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Right"/>
                            <!-- أزرار التنقل -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Command="{Binding FirstPageCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        Height="32" Width="32" Padding="4"
                                        ToolTip="{DynamicResource BtnFirstPage}">
                                    <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20"
                                                             Foreground="{DynamicResource GoldBrush}"/>
                                </Button>
                                <Button Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        Height="32" Width="32" Padding="4"
                                        ToolTip="{DynamicResource BtnPrevious}">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"
                                                             Foreground="{DynamicResource GoldBrush}"/>
                                </Button>
                                <Border Background="{DynamicResource InputBackground}"
                                        CornerRadius="6" Padding="12,4" Margin="4,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="CurrentPage"/>
                                                <Binding Path="TotalPages"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <Button Command="{Binding NextPageCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        Height="32" Width="32" Padding="4"
                                        ToolTip="{DynamicResource BtnNext}">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"
                                                             Foreground="{DynamicResource GoldBrush}"/>
                                </Button>
                                <Button Command="{Binding LastPageCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        Height="32" Width="32" Padding="4"
                                        ToolTip="{DynamicResource BtnLastPage}">
                                    <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20"
                                                             Foreground="{DynamicResource GoldBrush}"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- المشهد الفرعي 2: سجل المصادر المحذوفة (ReadOnly)  -->
                <!-- ══════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Grid.RowSpan="3"
                      Visibility="{Binding IsDeletedSourcesView, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Refresh -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Pagination -->
                    </Grid.RowDefinitions>

                    <!-- شريط البحث للمصادر المحذوفة -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                            
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                      Style="{DynamicResource SearchBox}" materialDesign:HintAssist.Hint="{DynamicResource HintSearchSources}"
                                      DockPanel.Dock="Right" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PrimaryBrush}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            
                            <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                    DockPanel.Dock="Right" Margin="2,0,4,0" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                    DockPanel.Dock="Right" Margin="2,0,12,0" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Cached" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                            <Button Command="{Binding ResetSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    DockPanel.Dock="Right" Margin="0,0,12,0" Height="40" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource BtnReset}" Margin="4,0,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- جدول المصادر المحذوفة (PetroleumBlue Standard ModernDataGrid Style) -->
                    <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,0" Padding="0" ClipToBounds="True">
                        <Grid>
                            <!-- DataGrid -->
                            <DataGrid ItemsSource="{Binding PagedDeletedSources}" Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      Visibility="{Binding HasDeletedSources, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <!-- الترقيم التسلسلي -->
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- كود المصدر -->
                                    <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding DisplaySourceCode}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource BoldCenterAligned}"/>

                                    <!-- النظائر -->
                                    <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- آخر نشاط إشعاعي -->
                                    <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- معدل الجرعة التقديري عند 1 متر -->
                                    <DataGridTemplateColumn Header="{DynamicResource ColDoseRate}" Width="Auto" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#141F5A66" CornerRadius="4" Padding="6,3" Margin="4,2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip="{Binding DoseRateTooltip}">
                                                    <TextBlock Text="{Binding DisplayDoseRate}"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               TextAlignment="Center"
                                                               FlowDirection="LeftToRight"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- الموقع -->
                                    <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding Location.LocationName, TargetNullValue='—'}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- الحالة قبل الحذف -->
                                    <DataGridTextColumn Header="{DynamicResource ColLastStatus}" Binding="{Binding ArabicStatus}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- تاريخ الحذف -->
                                    <DataGridTextColumn Header="{DynamicResource ColDeletedAt}" Binding="{Binding DeletedAt, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- حُذف بواسطة -->
                                    <DataGridTextColumn Header="{DynamicResource ColDeletedBy}" Binding="{Binding DeletedByUser.FullName, TargetNullValue='—'}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource SubtleCenterAligned}"/>

                                    <!-- إجراءات (عرض التفاصيل للقراءة فقط) -->
                                    <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ViewSourceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                        Padding="4" Height="30" Width="30"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        ToolTip="{DynamicResource ToolTipViewDetails}">
                                                    <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- حالة فارغة عند عدم وجود مصادر محذوفة -->
                            <Border Background="{DynamicResource CardBackground}" Padding="40"
                                    Visibility="{Binding HasDeletedSources, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="54" Height="54" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource EmptyDeletedSourcesTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource EmptyDeletedSourcesSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- شريط ترقيم صفحات المصادر المحذوفة -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="0,0,10,10" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,6,0,0"
                            Visibility="{Binding HasDeletedSources, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock Text="{Binding DeletedPageStatusText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Command="{Binding FirstDeletedPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnFirstPage}">
                                    <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                                <Button Command="{Binding PreviousDeletedPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnPrevious}">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                                <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,4" Margin="4,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="DeletedCurrentPage"/>
                                                <Binding Path="DeletedTotalPages"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <Button Command="{Binding NextDeletedPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnNext}">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                                <Button Command="{Binding LastDeletedPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnLastPage}">
                                    <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- المشهد 2: صفحة نموذج إضافة / تعديل مصدر (ملء الشاشة، تظهر عند التحرير) -->
            <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
            </ScrollViewer.InputBindings>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Title Bar -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Stepper Indicator -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Step Content -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Footer Buttons -->
                    </Grid.RowDefinitions>

                    <!-- ─── شريط العنوان ─── -->
                    <Border Grid.Row="0" CornerRadius="8,8,0,0" Padding="20,16"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- أيقونة العنوان داخل دائرة ناعمة -->
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" 
                                    Background="#141F5A66" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="Radioactive" Width="24" Height="24" 
                                                         Foreground="{DynamicResource PrimaryBrush}" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- عنوان النموذج -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource EditSourceTitle}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource AddSourceTitle}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- زر الإغلاق -->
                            <Button Grid.Column="2" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" Padding="0"
                                    ToolTip="{DynamicResource BtnCancel}">
                                <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ─── 1. مؤشر الخطوات البصري (Stepper) ─── -->
                    <Border Grid.Row="1" Padding="24,20,24,12" Background="{DynamicResource CardBackground}">
                        <Grid MaxWidth="640" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- الخطوة 1: تعريف المصدر -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#1F5A66"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                    <Setter Property="Background" Value="#141F5A66"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                    <Setter Property="Width" Value="36"/>
                                                    <Setter Property="Height" Value="36"/>
                                                    <Setter Property="CornerRadius" Value="18"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Background" Value="#141F5A66"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                    <Setter Property="Width" Value="36"/>
                                                    <Setter Property="Height" Value="36"/>
                                                    <Setter Property="CornerRadius" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- علامة الصح عند اكتمال الخطوة -->
                                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" 
                                                                 Foreground="{DynamicResource PrimaryBrush}" 
                                                                 VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <!-- أيقونة ورقم الخطوة 1 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="1" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource Step1Definition}" FontSize="12" TextAlignment="Center" FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- الخط الواصل بين الخطوة 1 و 2 -->
                            <Border Grid.Column="1" Height="3" CornerRadius="1.5" Margin="10,0,10,24" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- الخطوة 2: الخصائص الإشعاعية -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Width" Value="40"/>
                                                    <Setter Property="Height" Value="40"/>
                                                    <Setter Property="CornerRadius" Value="20"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#1F5A66"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Background" Value="#141F5A66"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Width" Value="36"/>
                                                    <Setter Property="Height" Value="36"/>
                                                    <Setter Property="CornerRadius" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- علامة الصح عند اكتمال الخطوة 2 -->
                                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" 
                                                                 Foreground="{DynamicResource PrimaryBrush}" 
                                                                 VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <!-- محتوى الخطوة 2 (أيقونة + رقم) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <materialDesign:PackIcon Kind="Atom" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="2" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource Step2Radiological}" FontSize="12" TextAlignment="Center" FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- الخط الواصل بين الخطوة 2 و 3 -->
                            <Border Grid.Column="3" Height="3" CornerRadius="1.5" Margin="10,0,10,24" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- الخطوة 3: اللوجستيات ومعاينة الصورة -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Width" Value="40"/>
                                                    <Setter Property="Height" Value="40"/>
                                                    <Setter Property="CornerRadius" Value="20"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#1F5A66"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MapMarkerRadiusOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="3" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource Step3Logistics}" FontSize="12" TextAlignment="Center" FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ─── محتوى خطوات النموذج ─── -->
                    <Border Grid.Row="2" Padding="24,10,24,16">
                        <Grid MaxWidth="780" VerticalAlignment="Top">
                            <!-- ─── الخطوة 1: تعريف المصدر ─── -->
                            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=1}">
                                
                                <!-- بطاقة فرعية 1: البيانات الأساسية -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- رأس البطاقة الفرعية -->
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Step1Definition}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- حقول البيانات الأساسية -->
                                        <StackPanel Margin="16,14">
                                            <UniformGrid Columns="2" Margin="0,0,0,0">
                                                <!-- كود المصدر -->
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="KeyOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSourceCodeReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditSourceCode}" TabIndex="1"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="SRC-001"/>
                                                </StackPanel>

                                                <!-- حالة المصدر -->
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="ListStatus" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSourceStatusReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <ComboBox SelectedValue="{Binding EditStatus}" SelectedValuePath="Tag" TabIndex="2"
                                                              IsEnabled="{Binding IsActivelyBorrowed, Converter={StaticResource InverseBoolConverter}}"
                                                              ToolTipService.ShowOnDisabled="True"
                                                              ToolTip="{Binding IsActivelyBorrowed, Converter={StaticResource BoolToValue}, ConverterParameter='لا يمكن تعديل الحالة لمصدر قيد الاستعارة النشطة حالياً|'}"
                                                              Style="{StaticResource FormComboBox}">
                                                        <ComboBoxItem Content="{DynamicResource StatusInUse}" Tag="InUse" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusStorage}" Tag="Storage" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusWaste}" Tag="Waste" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusTransfer}" Tag="Transfer" Foreground="{DynamicResource TextPrimary}"/>
                                                    </ComboBox>
                                                    <StackPanel Visibility="{Binding IsActivelyBorrowed, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="LockOutline" Width="14" Height="14" Foreground="#E0A93E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="الحالة مقفلة (المصدر قيد الاستعارة النشطة)" FontSize="11" Foreground="#E0A93E" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- صندوق توضيحات الحالات -->
                                            <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource StatusHintsTitle}" FontWeight="SemiBold" FontSize="11" 
                                                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{DynamicResource StatusHintInUse}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource StatusHintStorage}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource StatusHintWaste}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{DynamicResource StatusHintTransfer}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة فرعية 2: بيانات الجهاز والجهة المصنعة -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,0" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- رأس البطاقة الفرعية -->
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BarcodeScan" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource FieldSerialNumber}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- حقول الجهاز -->
                                        <StackPanel Margin="16,14">
                                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                                <!-- الرقم التسلسلي -->
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="Barcode" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSerialNumber}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditSerialNumber}" TabIndex="3"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="SN-12345"/>
                                                </StackPanel>

                                                <!-- الموديل -->
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldModel}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditModel}" TabIndex="4"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="XR-200"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- الشركة المصنعة -->
                                            <StackPanel Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Factory" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldManufacturer}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding EditManufacturer}" TabIndex="5"
                                                         Style="{StaticResource FormTextBox}"
                                                         materialDesign:HintAssist.Hint="Amersham"/>
                                            </StackPanel>

                                            <!-- خيار المصدر المختوم (خاضع لاختبار التسرب الدوري) -->
                                            <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                <CheckBox Content="{DynamicResource LabelIsSealedSource}" IsChecked="{Binding EditIsSealed}" 
                                                          FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>


                            <!-- ─── الخطوة 2: البيانات والخصائص الإشعاعية ─── -->
                            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=2}">
                                
                                <!-- خيار تعدد النظائر المشعة -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Background="{DynamicResource InputBackground}">
                                    <CheckBox Content="{DynamicResource LabelIsMultiIsotope}" IsChecked="{Binding IsMultiIsotope}" 
                                              FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>

                                <!-- بطاقة فرعية 1: نظير مشع أحادي (في حال عدم التفعيل) -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Background="{DynamicResource CardBackground}"
                                        Visibility="{Binding IsMultiIsotope, Converter={StaticResource InverseBoolToVis}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Atom" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Step2Radiological}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2" Margin="16,14">
                                            <!-- النظير المشع -->
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Atom" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldRadioisotopeReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Radioisotopes}" SelectedValue="{Binding EditRadioisotopeId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="Symbol"
                                                          Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>

                                            <!-- النشاط الابتدائي -->
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="FlashOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldInitialActivityReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding EditInitialActivityText, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource FormTextBox}"
                                                         materialDesign:HintAssist.Hint="3.7"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة فرعية 2: جدول النظائر المتعددة (عند تفعيل تعدد النظائر) -->
                                <Border Visibility="{Binding IsMultiIsotope, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" 
                                        Margin="0,0,0,14" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FormatListNumbered" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource ColRadioisotopes}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Margin="16,14">
                                            <DataGrid ItemsSource="{Binding IsotopeEntries}" AutoGenerateColumns="False" CanUserAddRows="False"
                                                      Style="{StaticResource ModernDataGrid}" MaxHeight="250"
                                                      CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                                                      AlternationCount="1000">
                                                <DataGrid.Columns>
                                                    <!-- عمود الترقيم البسيط # -->
                                                    <DataGridTemplateColumn Header="#" Width="45">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                           FontFamily="Segoe UI"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           TextAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource RowIndexConverter}">
                                                                            <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- عمود النظير المشع -->
                                                    <DataGridTemplateColumn Header="{DynamicResource ColRadioisotopes}" Width="*" MinWidth="130">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.Radioisotopes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedValue="{Binding RadioisotopeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                          SelectedValuePath="Id" DisplayMemberPath="Symbol"
                                                                          Style="{StaticResource CompactComboBox}" Margin="4"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- عمود النشاط الابتدائي -->
                                                    <DataGridTemplateColumn Header="{DynamicResource ColInitialActivity}" Width="*" MinWidth="110">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding InitialActivityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CompactTextBox}" Margin="4"
                                                                         TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- عمود وحدة النشاط الإشعاعي -->
                                                    <DataGridTemplateColumn Header="{DynamicResource ColActivityUnit}" Width="130" MinWidth="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.ActivityUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedValue="{Binding ActivityUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol"
                                                                          Style="{StaticResource CompactComboBox}" Margin="4"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- عمود الحذف -->
                                                    <DataGridTemplateColumn Width="45">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.RemoveIsotopeEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" HorizontalAlignment="Center"
                                                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="{DynamicResource DangerBrush}" 
                                                                        Padding="0" Height="28" Width="28" ToolTip="{DynamicResource CtxDelete}">
                                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- زر إضافة نظير جديد -->
                                            <Button Command="{Binding AddIsotopeEntryCommand}" 
                                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" 
                                                    Margin="0,14,0,0" Height="36" FontSize="13" Padding="16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource BtnAddIsotopeEntry}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة فرعية 3: وحدات النشاط الإشعاعي -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource ColActivityUnit}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2" Margin="16,14">
                                            <!-- وحدة النشاط الابتدائي -->
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Scale" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldInitialUnitReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedValue="{Binding EditInitialUnitId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol" Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>

                                            <!-- وحدة العرض المعتمدة -->
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCurrentUnitReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedValue="{Binding EditCurrentUnitId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol" Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ─── الخطوة 3: اللوجستيات ومعاينة الصورة ─── -->
                            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=3}">
                                
                                <!-- بطاقة فرعية 1: التاريخ والموقع -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MapMarkerRadiusOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource ColStorageLocation}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2" Margin="16,14">
                                            <!-- تاريخ المعايرة -->
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCalibrationDateReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <DatePicker SelectedDate="{Binding EditCalibrationDate}" Style="{StaticResource FormDatePicker}"/>
                                            </StackPanel>

                                            <!-- الموقع الحالي -->
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="MapMarkerOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCurrentLocationReq}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Locations}" SelectedValue="{Binding EditLocationId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="LocationName" 
                                                          IsEnabled="{Binding IsActivelyBorrowed, Converter={StaticResource InverseBoolConverter}}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          ToolTip="{Binding IsActivelyBorrowed, Converter={StaticResource BoolToValue}, ConverterParameter='لا يمكن تعديل الموقع لمصدر قيد الاستعارة النشطة حالياً|'}"
                                                          Style="{StaticResource FormComboBox}"/>
                                                <StackPanel Visibility="{Binding IsActivelyBorrowed, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="LockOutline" Width="14" Height="14" Foreground="#E0A93E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="الموقع مقفل (المصدر قيد الاستعارة النشطة)" FontSize="11" Foreground="#E0A93E" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة فرعية 2: صورة المصدر -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ImageOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource ColSourceImage}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="16,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- إطار معاينة الصورة مع أيقونة بديلة -->
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="8" 
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                                    Background="{DynamicResource InputBackground}" Margin="0,0,16,0" ClipToBounds="True">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="ImageOutline" Foreground="{DynamicResource TextSecondary}" Opacity="0.35" 
                                                                             Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                                             Visibility="{Binding EditImagePath, Converter={StaticResource NullToVis}, ConverterParameter='Inverse'}"/>
                                                    <Image Source="{Binding EditImagePath, Converter={StaticResource RelativePathToAbsolute}}" Stretch="UniformToFill">
                                                        <Image.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,96,96"/></Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <!-- زر اختيار الصورة والملاحظات -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Command="{Binding PickImageCommand}" Style="{DynamicResource SecondaryButton}" 
                                                        Height="38" Margin="0,0,0,8" HorizontalAlignment="Left" Padding="16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ImageEditOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource BtnPickImage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{DynamicResource LabelImageTip}" FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة فرعية 3: الملاحظات الإضافية -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Background="#121F5A66" CornerRadius="8,8,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource FieldAdditionalNotes}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="16,14">
                                            <TextBox Text="{Binding EditNotes}" Style="{StaticResource FormTextBox}" AcceptsReturn="True" MinLines="3" MaxLines="4" TextWrapping="Wrap"
                                                     materialDesign:HintAssist.Hint="{DynamicResource HintAdditionalNotes}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ─── شريط الأزرار السفلي (Steps Footer) ─── -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackground}" 
                            CornerRadius="0,0,8,8" Padding="24,14"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Cancel Button -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- زر السابق -->
                                <Button Command="{Binding PreviousStepCommand}" Height="42" Margin="0,0,12,0" Padding="20,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource BtnPrevious}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- زر التالي -->
                                <Button Command="{Binding NextStepCommand}" Height="42" Margin="0,0,12,0" Padding="20,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource BtnNext}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- زر الحفظ (يظهر في الخطوة 3 فقط) -->
                                <Button Style="{DynamicResource PrimaryButton}" 
                                        Command="{Binding SaveCommand}" IsDefault="True" 
                                        Height="42" Padding="24,0" Margin="0,0,12,0"
                                        Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=3}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource BtnSaveData}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- زر الإلغاء -->
                            <Button Grid.Column="2" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Height="42" Padding="20,0"
                                    materialDesign:ButtonAssist.CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnCancel}" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Grid>
</UserControl>