<UserControl x:Class="Sources.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Sources.Converters">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الجدول / أو نموذج التحرير -->
        <Grid Grid.Row="1">
            <!-- المشهد 1: صفحة قائمة المصادر والبحث (يختفي عند التحرير) -->
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Title & Actions -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Total Activity Stats (Sticky/Premium) -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Search & Filters -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Main Content (DataGrid/Pagination) -->
                </Grid.RowDefinitions>
                
                <!-- شريط العنوان والأزرار الأساسية (Row 0) -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                    <!-- العنوان في اليمين -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Radioactive" Width="32" Height="32" Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource SourcesManagementTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource SourcesManagementSubtitle}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- زر الإضافة في اليسار مع أزرار التصدير -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource BtnAddSource}" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding AddNewCommand}" Margin="0,0,8,0">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="{StaticResource GoldColor}"/>
                            </Button.Effect>
                        </Button>
                        
                        <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,8,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnExportPdf}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BtnExportExcel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- شريط إجمالي النشاط الإشعاعي (Row 1 - Premium Card) -->
                <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="20,12" Margin="0,0,0,16" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="0,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- التسمية والأيقونة -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LabelTotalActivityStats}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- الوحدات المحولة -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TotalActivityItems}" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource GoldBrush}" CornerRadius="6" Padding="12,5" Margin="0,0,10,5">
                                        <TextBlock Text="{Binding DisplayValue}" FontWeight="Bold" FontSize="13" Foreground="#121212" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- شريط البحث والفلترة (Row 2) -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <DockPanel>
                        <!-- أيقونة الفلترة -->
                        <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                        
                        <!-- صندوق البحث -->
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                  Style="{DynamicResource SearchBox}" materialDesign:HintAssist.Hint="{DynamicResource HintSearchSources}"
                                  DockPanel.Dock="Right" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GoldBrush}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <!-- زر البحث -->
                        <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{Binding Converter={StaticResource BoolToValue}, ConverterParameter='Search|بحث'}"
                                DockPanel.Dock="Right" Margin="2,0,4,0" Padding="4" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>

                        <!-- زر التحديث -->
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{DynamicResource ToolTipRefreshActivity}"
                                DockPanel.Dock="Right" Margin="2,0,12,0" Padding="4" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Cached" Width="20" Height="20" Foreground="{DynamicResource GoldBrush}"/>
                        </Button>
                        
                        <!-- تصفية الحالة -->
                        <ComboBox SelectedValue="{Binding StatusFilter}" Width="160" Margin="0,0,16,0"
                                  Style="{DynamicResource FormComboBox}"
                                  materialDesign:HintAssist.Hint="{DynamicResource FilterAllStatuses}" DockPanel.Dock="Right">
                            <ComboBoxItem Content="{DynamicResource FilterAllStatuses}" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource StatusActive}" Tag="Active"/>
                            <ComboBoxItem Content="{DynamicResource StatusDecayed}" Tag="Decayed"/>
                            <ComboBoxItem Content="{DynamicResource StatusDisposed}" Tag="Disposed"/>
                        </ComboBox>

                        <!-- زر إعادة التعيين -->
                        <Button Command="{Binding ResetSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                DockPanel.Dock="Right" Margin="0,0,12,0" Height="40" BorderBrush="{DynamicResource GoldBrush}" Foreground="{DynamicResource GoldBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource BtnReset}" Margin="4,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock/>
                    </DockPanel>
                </Border>

                <!-- منطقة البيانات الرئيسية (Row 3 - DataGrid & Pagination) -->
                <Border Grid.Row="3" Style="{DynamicResource ContentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Style="{DynamicResource ModernDataGrid}"
                                  HeadersVisibility="Column" LoadingRow="DataGrid_LoadingRow" CanUserResizeColumns="False" 
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ColumnWidth="*">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="40" ElementStyle="{StaticResource CenterAligned}"/>
                                <DataGridTemplateColumn Header="{DynamicResource ColSourceImage}" Width="60">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}">
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="36" Height="36" CornerRadius="4" 
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                    Background="{DynamicResource InputBackground}"
                                                    Margin="2" ClipToBounds="True">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="Image" Width="18" Height="18" 
                                                                             Foreground="{DynamicResource TextSecondary}"
                                                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                             Visibility="{Binding ImagePath, Converter={StaticResource NullToVis}, ConverterParameter='Inverse'}"/>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource RelativePathToAbsolute}}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                               <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding SourceCode}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColRadioisotopes}" Binding="{Binding DisplayIsotopes}" Width="1.5*" ElementStyle="{StaticResource WrappingCenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColSerialNumber}" Binding="{Binding SerialNumber}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColInitialActivity}" Binding="{Binding InitialActivityDisplay}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityDisplay}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColActivityUnit}" Binding="{Binding CurrentActivityUnit.UnitSymbol}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColStorageLocation}" Binding="{Binding Location.LocationName}" Width="1.2*" ElementStyle="{StaticResource WrappingCenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColSourceStatus}" Binding="{Binding SimpleArabicStatus}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColAddedBy}" Binding="{Binding AddedBy}" Width="Auto" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTextColumn Header="{DynamicResource ColCalibrationDate}" Binding="{Binding CalibrationDate, StringFormat=yyyy-MM-dd}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>
                               <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="120">
                                   <DataGridTemplateColumn.CellTemplate>
                                       <DataTemplate>
                                           <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                               <Button Command="{Binding DataContext.ViewSourceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolForegroundButton}" Padding="4" Height="32" Width="32" ToolTip="{DynamicResource ToolTipViewDetails}">
                                                   <materialDesign:PackIcon Kind="Eye" Width="20" Height="20"/>
                                               </Button>
                                               <Button Command="{Binding DataContext.EditSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolForegroundButton}" Padding="4" Height="32" Width="32" Foreground="{DynamicResource GoldBrush}" ToolTip="{DynamicResource CtxEdit}">
                                                   <materialDesign:PackIcon Kind="Edit" Width="20" Height="20"/>
                                               </Button>
                                               <Button Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolForegroundButton}" Padding="4" Height="32" Width="32" Foreground="Red" ToolTip="{DynamicResource CtxDelete}">
                                                   <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                                               </Button>
                                           </StackPanel>
                                       </DataTemplate>
                                   </DataGridTemplateColumn.CellTemplate>
                               </DataGridTemplateColumn>
                           </DataGrid.Columns>
                       </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        <!-- المشهد 2: صفحة نموذج إضافة / تعديل مصدر (ملء الشاشة، تظهر عند التحرير) -->
        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
            </ScrollViewer.InputBindings>
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Margin="0,0,0,24">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ─── شريط العنوان الذهبي ─── -->
                        <Border Grid.Row="0" CornerRadius="8,8,0,0" Padding="20,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D4AF37" Offset="0"/>
                                    <GradientStop Color="#C5962E" Offset="0.5"/>
                                    <GradientStop Color="#B8860B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- أيقونة داخل دائرة -->
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" 
                                        Background="#33FFFFFF" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="Radioactive" Width="28" Height="28" 
                                                             Foreground="#1A1A2E" 
                                                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                
                                <!-- العنوان -->
                                <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource EditSourceTitle}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource AddSourceTitle}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- زر الإغلاق -->
                                <Button Grid.Column="2" Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="35" Height="35" Padding="0">
                                    <materialDesign:PackIcon Kind="Close" Foreground="#1A1A2E" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ─── محتوى النموذج (Steps) ─── -->
                        <Border Grid.Row="1" Padding="24,10,24,10">
                            <Grid MaxWidth="760" VerticalAlignment="Top">
                                <!-- Step 1: Identification -->
                                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=1}">
                                    <!-- Step Title with Icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="CardAccountDetails" Width="22" Height="22" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Step1Definition}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Sub-Card: Basic Info -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,8" Background="{DynamicResource InputBackground}">
                                        <StackPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="Key" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSourceCodeReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditSourceCode}" TabIndex="1"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="SRC-001"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="ListStatus" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSourceStatusReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <ComboBox SelectedValue="{Binding EditStatus}" SelectedValuePath="Tag" TabIndex="2"
                                                              Style="{StaticResource FormComboBox}">
                                                        <ComboBoxItem Content="{DynamicResource StatusInUse}" Tag="InUse" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusStorage}" Tag="Storage" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusWaste}" Tag="Waste" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ComboBoxItem Content="{DynamicResource StatusTransfer}" Tag="Transfer" Foreground="{DynamicResource TextPrimary}"/>
                                                    </ComboBox>
                                                    <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                                            BorderBrush="#33D4AF37" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource StatusHintsTitle}" FontWeight="SemiBold" FontSize="11" 
                                                                       Foreground="{StaticResource GoldBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{DynamicResource StatusHintInUse}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{DynamicResource StatusHintStorage}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{DynamicResource StatusHintWaste}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{DynamicResource StatusHintTransfer}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sub-Card: Device Info -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,0" Background="{DynamicResource InputBackground}">
                                        <StackPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="Barcode" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldSerialNumber}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditSerialNumber}" TabIndex="3"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="SN-12345"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="Cog" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource FieldModel}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding EditModel}" TabIndex="4"
                                                             Style="{StaticResource FormTextBox}"
                                                             materialDesign:HintAssist.Hint="XR-200"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <StackPanel Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Factory" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldManufacturer}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding EditManufacturer}" TabIndex="5"
                                                         Style="{StaticResource FormTextBox}"
                                                         materialDesign:HintAssist.Hint="Amersham"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Step 2: Technical & Isotopes -->
                                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=2}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="Radioactive" Width="22" Height="22" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Step2Radiological}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox Content="{DynamicResource LabelIsMultiIsotope}" IsChecked="{Binding IsMultiIsotope}" 
                                                  FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <!-- Sub-Card: Single Isotope -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,8" Background="{DynamicResource InputBackground}"
                                            Visibility="{Binding IsMultiIsotope, Converter={StaticResource InverseBoolToVis}}">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Atom" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldRadioisotopeReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Radioisotopes}" SelectedValue="{Binding EditRadioisotopeId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="Symbol"
                                                          Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Flash" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldInitialActivityReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding EditInitialActivityText, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource FormTextBox}"
                                                         materialDesign:HintAssist.Hint="3.7"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                     <!-- Multi Isotopes -->
                                    <Border Visibility="{Binding IsMultiIsotope, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" CornerRadius="10" 
                                            Padding="12" Margin="0,0,0,12" Background="{DynamicResource CardBackground}">
                                        <StackPanel>
                                            <DataGrid ItemsSource="{Binding IsotopeEntries}" AutoGenerateColumns="False" CanUserAddRows="False"
                                                      Style="{StaticResource ModernDataGrid}" MaxHeight="250"
                                                      CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#22D4AF37">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="{DynamicResource ColRadioisotopes}" Width="*" MinWidth="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.Radioisotopes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedValue="{Binding RadioisotopeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                          SelectedValuePath="Id" DisplayMemberPath="Symbol"
                                                                          Style="{StaticResource CompactComboBox}" Margin="4"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource ColInitialActivity}" Width="*" MinWidth="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding InitialActivityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CompactTextBox}" Margin="4"
                                                                         TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource FieldTimeUnit}" Width="100" MinWidth="80">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.ActivityUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedValue="{Binding ActivityUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol"
                                                                          Style="{StaticResource CompactComboBox}" Margin="4"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="45">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="🗑️" Command="{Binding DataContext.RemoveIsotopeEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" HorizontalAlignment="Center"
                                                                        Style="{StaticResource MaterialDesignToolButton}" Foreground="{DynamicResource DangerBrush}" Padding="0" Height="28" Width="28" ToolTip="{DynamicResource CtxDelete}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="{DynamicResource BtnAddIsotopeEntry}" Command="{Binding AddIsotopeEntryCommand}" 
                                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" 
                                                    Margin="0,12,0,0" Height="36" FontSize="12" Width="200"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sub-Card: Units -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Background="{DynamicResource InputBackground}">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Scale" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldInitialUnitReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedValue="{Binding EditInitialUnitId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol" Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCurrentUnitReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedValue="{Binding EditCurrentUnitId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="UnitSymbol" Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>

                                <!-- Step 3: Logistics & Media -->
                                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=3}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="Truck" Width="22" Height="22" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Step3Logistics}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Sub-Card: Date & Location -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,8" Background="{DynamicResource InputBackground}">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="Calendar" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCalibrationDateReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <DatePicker SelectedDate="{Binding EditCalibrationDate}" Style="{StaticResource FormDatePicker}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource FieldCurrentLocationReq}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Locations}" SelectedValue="{Binding EditLocationId}" 
                                                          SelectedValuePath="Id" DisplayMemberPath="LocationName" Style="{StaticResource FormComboBox}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- 📷 Image Sub-Card -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,8" Background="{DynamicResource InputBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="90" Height="90" CornerRadius="8" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" Background="#22000000" Margin="0,0,15,0">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="Image" Foreground="#44FFFFFF" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EditImagePath, Converter={StaticResource NullToVis}, ConverterParameter='Inverse'}"/>
                                                    <Image Source="{Binding EditImagePath, Converter={StaticResource RelativePathToAbsolute}}" Stretch="UniformToFill">
                                                        <Image.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,90,90"/></Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource BtnPickImage}" Command="{Binding PickImageCommand}" Style="{DynamicResource SecondaryButton}" Height="35" Margin="0,0,0,5"/>
                                                <TextBlock Text="{DynamicResource LabelImageTip}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Notes Sub-Card -->
                                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Background="{DynamicResource InputBackground}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="NoteOutline" Width="16" Height="16" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource FieldAdditionalNotes}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding EditNotes}" Style="{StaticResource FormTextBox}" AcceptsReturn="True" MinLines="3" MaxLines="3" TextWrapping="Wrap"
                                                     materialDesign:HintAssist.Hint="{DynamicResource HintAdditionalNotes}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ─── شريط الأزرار السفلي (Steps Footer) ─── -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" 
                                CornerRadius="0,0,8,8" Padding="20,10"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                    <ColumnDefinition Width="Auto"/> <!-- Status -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="{DynamicResource BtnPrevious}" 
                                            Command="{Binding PreviousStepCommand}" Width="100" Height="42" Margin="0,0,12,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="{DynamicResource BtnNext}" 
                                            Command="{Binding NextStepCommand}" Width="100" Height="42" Margin="0,0,12,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Save Button (Step 3) -->
                                    <Button Content="{DynamicResource BtnSaveData}" Style="{DynamicResource PrimaryButton}" 
                                            Command="{Binding SaveCommand}" IsDefault="True" 
                                            Width="160" Height="42" Margin="0,0,12,0"
                                            Visibility="{Binding CurrentStep, Converter={StaticResource EqualityToVis}, ConverterParameter=3}"/>

                                    <Button Content="{DynamicResource BtnCancel}" Style="{DynamicResource SecondaryButton}" 
                                            Command="{Binding CancelEditCommand}" Width="100" Height="42"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource LabelStep}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentStep}" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="4,0"/>
                                    <TextBlock Text="{DynamicResource LabelOf}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="3" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>