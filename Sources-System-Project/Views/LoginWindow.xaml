<Window x:Class="Sources.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource LoginWindowTitle}" 
        Width="520"
        Height="590"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- Opaque Deep Petroleum/Navy Background -->
        <Border Background="#0B1728" />

        <!-- Backdrop Background Image with Soft Blur -->
        <Image Source="pack://siteoforigin:,,,/Assets/sources_backdrop.jpg" Stretch="UniformToFill" Opacity="0.35">
            <Image.Effect>
                <BlurEffect Radius="20" RenderingBias="Quality" />
            </Image.Effect>
        </Image>
        
        <!-- Dark Tint Overlay -->
        <Border Background="#880B1728" />

        <!-- Centered Main Login Card -->
        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.2"
                Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Color="#070D17" Opacity="0.45" ShadowDepth="4"/>
            </Border.Effect>
            
            <Grid Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Window Controls -->
                    <RowDefinition Height="Auto" /> <!-- Header Section (Side-by-side logos + titles) -->
                    <RowDefinition Height="Auto" /> <!-- Fields & Login Button -->
                    <RowDefinition Height="Auto" /> <!-- Credits Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Window Controls -->
                <StackPanel x:Name="WindowControlsPanel" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="28" Height="28" Padding="0" Click="MinimizeButton_Click" ToolTip="{DynamicResource TooltipMinimize}">
                        <materialDesign:PackIcon Kind="WindowMinimize" Foreground="#64748B" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource MaterialDesignFlatButton}" Width="28" Height="28" Padding="0" Click="MaximizeButton_Click" ToolTip="{DynamicResource TooltipMaximize}" Margin="3,0,0,0">
                        <materialDesign:PackIcon x:Name="IconMaximize" Kind="WindowMaximize" Foreground="#64748B" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="28" Height="28" Padding="0" Click="CloseButton_Click" ToolTip="{DynamicResource TooltipClose}" Margin="3,0,0,0">
                        <materialDesign:PackIcon Kind="Close" Foreground="#DC2626" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- 2. Header Section (Side-by-side balanced logos + center title) -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- شعار مركز البحوث النووية - تاجوراء (82x82) -->
                    <Border Grid.Column="0" Width="82" Height="82" CornerRadius="41" Background="#F8FAFC" 
                            BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="4" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#1B365D" Opacity="0.15" ShadowDepth="1"/>
                        </Border.Effect>
                        <Image Source="pack://siteoforigin:,,,/Assets/tnrc_3d_final.png" 
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- العناوين المركزية الموحدة -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,6,0">
                        <TextBlock Text="{DynamicResource CenterName}" FontSize="14" FontWeight="Bold" 
                                   Foreground="#1B365D" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource CenterAcronym}" FontSize="12" FontWeight="Bold" 
                                   Foreground="#C97A4A" HorizontalAlignment="Center" Margin="0,1,0,3" />
                        
                        <Border Height="1" Background="#E2E8F0" Margin="10,1,10,3" />
                        
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,2">
                            <Run Text="{DynamicResource SystemTitlePart1}" FontSize="14.5" FontWeight="Bold" Foreground="#1B365D"/>
                            <Run Text="{DynamicResource SystemTitlePart2}" FontSize="14.5" FontWeight="Bold" Foreground="#C97A4A"/>
                        </TextBlock>
                        
                        <TextBlock Text="{DynamicResource SystemSubtitle}" FontSize="10.5" Foreground="#64748B" 
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- شعار منظومة مصادر (مكبّر وبارز ومكتمل 82x82) -->
                    <Border Grid.Column="2" Width="82" Height="82" CornerRadius="41" Background="#F8FAFC" 
                            BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="4" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#1B365D" Opacity="0.18" ShadowDepth="1"/>
                        </Border.Effect>
                        <Image Source="pack://siteoforigin:,,,/Assets/sources_logo.png" 
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>

                <!-- 3. Input Fields & Form -->
                <StackPanel Grid.Row="2" Margin="6,0,6,8">
                    <!-- Welcome Banner (Temporary 3s) -->
                    <Border x:Name="WelcomeBanner" Background="#E8F4F8" BorderBrush="#1F5A66" BorderThickness="1.5" 
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="HandWave" Width="20" Height="20" Foreground="#C97A4A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtWelcome" Text="{DynamicResource LoginWelcome}" FontSize="13" FontWeight="SemiBold" Foreground="#1F5A66" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- اسم المستخدم -->
                    <TextBlock Text="{DynamicResource LabelUsername}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4" />
                    <ComboBox x:Name="TxtUsername" 
                              IsEditable="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              MinHeight="46"
                              Padding="12,0,12,0"
                              FontSize="14"
                              Foreground="#0F172A"
                              Margin="0,0,0,10"
                              KeyDown="TxtUsername_KeyDown"
                              VerticalContentAlignment="Center" />

                    <!-- كلمة المرور -->
                    <TextBlock Text="{DynamicResource LabelPassword}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="TxtPassword" 
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     MinHeight="46"
                                     Padding="12,0,40,0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     KeyDown="TxtPassword_KeyDown"
                                     VerticalContentAlignment="Center" />
                        <TextBox x:Name="TxtPasswordReveal" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="46"
                                 Padding="12,0,40,0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 Visibility="Collapsed"
                                 KeyDown="TxtPassword_KeyDown"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="BtnRevealPassword" Click="BtnRevealPassword_Click"
                                Style="{StaticResource MaterialDesignToolButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Width="28" Height="28" Padding="0"
                                ToolTip="{DynamicResource TooltipShowPassword}">
                            <materialDesign:PackIcon x:Name="IconRevealPassword" Kind="Eye" Width="18" Height="18" Foreground="#64748B" />
                        </Button>
                    </Grid>

                    <!-- خيار "تذكرني" -->
                    <CheckBox x:Name="ChkRememberMe" 
                              Content="{DynamicResource LabelRememberMe}" 
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="#334155"
                              Margin="0,0,0,8" 
                              HorizontalAlignment="Stretch" />
                    
                    <!-- Error Message Block -->
                    <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12.5" FontWeight="SemiBold" 
                               Margin="0,0,0,8" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <!-- زر "تسجيل الدخول" -->
                    <Button x:Name="BtnLogin" 
                            Content="{DynamicResource BtnLogin}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1B365D" 
                            Foreground="White"
                            BorderBrush="#C97A4A"
                            BorderThickness="1.5"
                            Height="44" 
                            FontSize="15" 
                            FontWeight="Bold"
                            Margin="0,2,0,6" 
                            Click="BtnLogin_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#1B365D" Opacity="0.25" ShadowDepth="2"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <!-- 4. تذييل التصميم والتطوير -->
                <StackPanel Grid.Row="3" Margin="0,2,0,0">
                    <Separator Background="#E2E8F0" Margin="0,0,0,5" />
                    <TextBlock Text="{DynamicResource CreditsDesignedBy}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource DesignerName1}" FontSize="12" FontWeight="Bold" Foreground="#1B365D" />
                        <TextBlock Text="  •  " FontSize="12" Foreground="#94A3B8" />
                        <TextBlock Text="{DynamicResource DesignerName2}" FontSize="12" FontWeight="Bold" Foreground="#1B365D" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
