<Window x:Class="Sources.Views.NeutronSourceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Sources.ViewModels"
        Title="{DynamicResource TitleNeutronSourceDetails}"
        Width="860" Height="720"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header -->
            <RowDefinition Height="*"/>    <!-- 2. TabControl Body -->
            <RowDefinition Height="Auto"/> <!-- 3. Footer -->
        </Grid.RowDefinitions>

        <!-- ════════ 1. Header ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D9488" Width="48" Height="48" CornerRadius="12" Padding="8">
                        <materialDesign:PackIcon Kind="AtomVariant" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource TitleNeutronSourceDetails}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" — " FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SourceCode}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <!-- شارة حالة المصدر -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Border Background="{Binding StatusColor, Converter={StaticResource HexToBrush}}" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="{Binding StatusArabic}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ 2. TabControl Body ════════ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource SourcesSystemTabControlStyle}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ─── التبويب 1: التفاصيل ─── -->
            <TabItem Header="{DynamicResource TabDetails}" Style="{StaticResource SourcesSystemTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,4,0">
                    <StackPanel>
                        <!-- ─── 1. بطاقة الهوية والنوع المرجعي ─── -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DetailCardNeutronIdentity}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- كود المصدر -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelSourceCode}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SourceCode}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- الرقم التسلسلي -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelSerialNumber}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SerialNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- النوع المرجعي -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelNeutronRefType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding TypeCode}" FontSize="14" FontWeight="Bold" Foreground="#0D9488" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TypeNameAr}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <!-- تفاعل التوليد -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelReactionType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding ReactionType}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- مادة الهدف / النظير الأب -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource DetailLabelTargetMaterialParent}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding TargetMaterial}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- عمر النصف -->
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="{DynamicResource DetailLabelHalfLife}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding HalfLifeDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── 2. بطاقة الخصائص الإشعاعية والانبعاث ─── -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="Wave" Width="20" Height="20" Foreground="#0D9488" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DetailCardNeutronEmissionProps}" FontSize="15" FontWeight="Bold" Foreground="#0D9488" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 1. معدل الانبعاث المُعاير وتاريخ المعايرة -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource DetailLabelCalibratedEmissionRate}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding CalibratedEmissionRateFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- تاريخ معايرة الانبعاث -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource DetailLabelEmissionCalibrationDate}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding EmissionCalibrationDateFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 2. معدل الانبعاث الحالي (محسوباً بتاريخ اليوم) -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource DetailLabelCurrentEmissionRate}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding CurrentEmissionRateDisplay}" FontSize="16" FontWeight="Bold" Foreground="#0D9488" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 3. مرجع المعايرة -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelCalibrationReference}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding CalibrationReferenceDisplay}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 4. عامل التباين الاتجاهي -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource DetailLabelAnisotropyFactor}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding AnisotropyFactorDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 5. نسبة عدم اليقين الموسعة -->
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource DetailLabelUncertainty}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding UncertaintyFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 6. متوسط طاقة النيترونات -->
                                    <StackPanel Grid.Row="3" Grid.Column="1">
                                        <TextBlock Text="{DynamicResource DetailLabelAverageNeutronEnergy}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding EnergyDisplay}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── 3. بطاقة الموقع والملاحظات ─── -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="MapMarkerOutline" Width="20" Height="20" Foreground="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource DetailCardLocationNotes}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource DetailLabelCurrentLocation}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding LocationDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding LocationDetails}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource DetailLabelNotes}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding Notes}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── 4. بطاقة سجل التدقيق ─── -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,14"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource DetailLabelCreatedAt}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding CreatedAtFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource DetailLabelAddedBy}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding AddedByName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource DetailLabelUpdatedAt}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding UpdatedAtFormatted}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── التبويب 2: الشهادات والمستندات ─── -->
            <TabItem Header="{DynamicResource TabCertificates}" Style="{StaticResource SourcesSystemTabItemStyle}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Bar -->
                        <RowDefinition Height="*"/>    <!-- Certificates List / Empty State -->
                    </Grid.RowDefinitions>

                    <!-- شريط الإجراءات العلوي -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding AttachCertificateCommand}"
                                    Style="{DynamicResource PrimaryButton}" Height="38" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Paperclip" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnAttachCertificate}" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- محتوى الشهادات (جدول أو حالة فارغة) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- جدول الشهادات المرفقة -->
                            <DataGrid ItemsSource="{Binding Certificates}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Visibility="{Binding HasCertificates, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <!-- اسم الملف الأصلي -->
                                    <DataGridTemplateColumn Header="{DynamicResource ColFileName}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- تاريخ الإرفاق -->
                                    <DataGridTextColumn Header="{DynamicResource ColAttachedAt}" Binding="{Binding AttachedAtFormatted}" Width="160" ElementStyle="{StaticResource CenterAligned}"/>

                                    <!-- أُرفق بواسطة -->
                                    <DataGridTextColumn Header="{DynamicResource ColAttachedBy}" Binding="{Binding AttachedBy}" Width="150" ElementStyle="{StaticResource SubtleCenterAligned}"/>

                                    <!-- أزرار الإجراءات (فتح، تنزيل، حذف) -->
                                    <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <!-- زر الفتح -->
                                                    <Button Command="{Binding DataContext.OpenCertificateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Height="32" Width="32" Padding="0" Margin="2,0"
                                                            Foreground="#0D9488"
                                                            ToolTip="{DynamicResource BtnOpenCertificate}">
                                                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                                    </Button>

                                                    <!-- زر التنزيل -->
                                                    <Button Command="{Binding DataContext.DownloadCertificateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Height="32" Width="32" Padding="0" Margin="2,0"
                                                            Foreground="#0D9488"
                                                            ToolTip="{DynamicResource BtnDownloadCertificate}">
                                                        <materialDesign:PackIcon Kind="DownloadOutline" Width="18" Height="18"/>
                                                    </Button>

                                                    <!-- زر الحذف -->
                                                    <Button Command="{Binding DataContext.DeleteCertificateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Height="32" Width="32" Padding="0" Margin="2,0"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            ToolTip="{DynamicResource BtnDeleteCertificate}">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- حالة فارغة عند عدم وجود شهادات -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                        Visibility="{Binding HasCertificates, Converter={StaticResource InverseBoolToVis}}">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="56" Height="56" Foreground="{DynamicResource TextSecondary}" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource EmptyCertificates}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource EmptyCertificatesSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ════════ 3. Footer ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,10" Margin="0,14,0,0"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource BtnClose}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="CloseButton_Click" MinWidth="110" Height="36" IsCancel="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
