<Window x:Class="Sources.Views.NeutronSourceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Sources.ViewModels"
        Title="{DynamicResource TitleNeutronSourceDetails}"
        Width="820" Height="680"
        MinWidth="720" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header -->
            <RowDefinition Height="*"/>    <!-- 2. Scrollable Body -->
            <RowDefinition Height="Auto"/> <!-- 3. Footer -->
        </Grid.RowDefinitions>

        <!-- ════════ 1. Header ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D9488" Width="48" Height="48" CornerRadius="12" Padding="8">
                        <materialDesign:PackIcon Kind="AtomVariant" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource TitleNeutronSourceDetails}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" — " FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SourceCode}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <!-- شارة حالة المصدر -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Border Background="{Binding StatusColor, Converter={StaticResource HexToBrush}}" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="{Binding StatusArabic}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ 2. Scrollable Body ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- ─── 1. بطاقة الهوية والنوع المرجعي ─── -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DetailCardNeutronIdentity}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- كود المصدر -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelSourceCode}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SourceCode}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- الرقم التسلسلي -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelSerialNumber}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SerialNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- النوع المرجعي -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelNeutronRefType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding TypeCode}" FontSize="14" FontWeight="Bold" Foreground="#0D9488" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding TypeNameAr}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <!-- تفاعل التوليد -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelReactionType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ReactionType}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- مادة الهدف / النظير الأب -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{DynamicResource DetailLabelTargetMaterialParent}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding TargetMaterial}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- عمر النصف -->
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="{DynamicResource DetailLabelHalfLife}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding HalfLifeDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 2. بطاقة الخصائص الإشعاعية والانبعاث ─── -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="Wave" Width="20" Height="20" Foreground="#0D9488" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DetailCardNeutronEmissionProps}" FontSize="15" FontWeight="Bold" Foreground="#0D9488" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- معدل الانبعاث -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelEmissionRate}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding EmissionRateFormatted}" FontSize="16" FontWeight="Bold" Foreground="#0D9488" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- نسبة عدم اليقين -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource DetailLabelUncertainty}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding UncertaintyFormatted}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- متوسط الطاقة -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="{DynamicResource DetailLabelAverageNeutronEnergy}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding EnergyDisplay}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- تاريخ المعايرة -->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="{DynamicResource DetailLabelCalibrationDate}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding CalibrationDateFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 3. بطاقة الموقع والملاحظات ─── -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="MapMarkerOutline" Width="20" Height="20" Foreground="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DetailCardLocationNotes}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource DetailLabelCurrentLocation}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding LocationDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding LocationDetails}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource DetailLabelNotes}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding Notes}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 4. بطاقة سجل التدقيق ─── -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,14"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource DetailLabelCreatedAt}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding CreatedAtFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource DetailLabelAddedBy}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding AddedBy}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource DetailLabelUpdatedAt}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding UpdatedAtFormatted}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ 3. Footer ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,10" Margin="0,14,0,0"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource BtnClose}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="CloseButton_Click" MinWidth="110" Height="36"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
