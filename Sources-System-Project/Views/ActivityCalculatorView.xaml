<UserControl x:Class="Sources.Views.ActivityCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Sources.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" MaxWidth="850" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════ شريط العنوان ═══════ -->
            <Border Grid.Row="0" CornerRadius="12" Padding="20,14" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" Color="{StaticResource PrimaryDarkColor}"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25"
                            Background="#33FFFFFF" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28"
                                                 Foreground="White"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource CalcTitle}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource CalcSubtitle}" FontSize="13" Foreground="White" Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════ بطاقة المدخلات ═══════ -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="24,20" Margin="0,0,0,16">
                <StackPanel>

                    <!-- ── نوع الإدخال ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="{DynamicResource CalcRadioFromDB}" IsChecked="{Binding IsFromDatabase}" Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,24,0" Foreground="{DynamicResource TextPrimary}"/>
                        <RadioButton Content="{DynamicResource CalcRadioManual}" IsChecked="{Binding IsManualInput}" Style="{StaticResource MaterialDesignRadioButton}" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <!-- ── اختيار النظير المشع (من القاعدة) ── -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding IsFromDatabase, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="Atom" Width="18" Height="18"
                                                     Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource CalcFieldIsotope}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Isotopes}" SelectedItem="{Binding SelectedIsotope}"
                                  Style="{StaticResource FormComboBox}" FontSize="14"
                                  materialDesign:HintAssist.Hint="{DynamicResource CalcFieldIsotope}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="—" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- ── اسم النظير (يدوي) ── -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding IsManualInput, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"
                                                     Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource CalcFieldIsotope}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <TextBox Text="{Binding CustomIsotopeName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" FontSize="14"
                                 materialDesign:HintAssist.Hint="{DynamicResource CalcFieldIsotope}" />
                    </StackPanel>

                    <!-- ── النشاط الأولي A₀ مع الوحدة ── -->
                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,12" Background="{DynamicResource InputBackground}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="Radioactive" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldInitialActivity}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBox Text="{Binding InitialActivityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         materialDesign:HintAssist.Hint="{DynamicResource CalcHintActivity}"
                                         FlowDirection="LeftToRight" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldInputUnit}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding InitialActivityUnit}"
                                          Style="{StaticResource FormComboBox}" FontSize="13"
                                          FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- ── نصف العمر + الوحدة ── -->
                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,12" Background="{DynamicResource InputBackground}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="TimerSandEmpty" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldHalfLife}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBox Text="{Binding HalfLifeValueText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         IsReadOnly="{Binding IsFromDatabase}"
                                         materialDesign:HintAssist.Hint="{DynamicResource CalcHintHalfLife}"
                                         FlowDirection="LeftToRight" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="Clock" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldTimeUnit}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding TimeUnits}" SelectedItem="{Binding HalfLifeUnit}"
                                          Style="{StaticResource FormComboBox}" FontSize="13"
                                          IsEnabled="{Binding IsManualInput}"
                                          FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- ── تاريخ المعايرة/الصنع + تاريخ الحساب ── -->
                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,12" Background="{DynamicResource InputBackground}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldCalibrationDate}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <DatePicker SelectedDate="{Binding CalibrationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            FontSize="13" FlowDirection="LeftToRight"
                                            materialDesign:HintAssist.Hint="dd/MM/yyyy"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16"
                                                             Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource CalcFieldCalculationDate}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <DatePicker SelectedDate="{Binding CalculationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            FontSize="13" FlowDirection="LeftToRight"
                                            materialDesign:HintAssist.Hint="dd/MM/yyyy"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- ── وحدة الخرج ── -->
                    <Border BorderBrush="#33D4AF37" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,0,0,16" Background="{DynamicResource InputBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16"
                                                         Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource CalcFieldOutputUnit}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding SelectedOutputUnit}"
                                      Style="{StaticResource FormComboBox}" FontSize="13"
                                      FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>

                    <!-- ── رسالة الخطأ ── -->
                    <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                            Background="#33FF4444" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18"
                                                     Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF4444" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── الأزرار ── -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource CalcBtnCalculate}" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding CalculateCommand}" Width="160" Height="44" Margin="0,0,16,0">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="{StaticResource PrimaryColor}"/>
                            </Button.Effect>
                        </Button>
                        <Button Content="{DynamicResource CalcBtnReset}" Style="{DynamicResource SecondaryButton}"
                                Command="{Binding ResetCommand}" Width="120" Height="44"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════ بطاقة النتائج ═══════ -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}" Padding="24,20" Margin="0,0,0,16"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>

                    <!-- الفترة الزمنية المنقضية -->
                    <Border Background="{DynamicResource InputBackground}" CornerRadius="10" Padding="16,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource CalcResultElapsed}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElapsedTimeText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <!-- ثابت التحلل λ -->
                    <Border Background="{DynamicResource InputBackground}" CornerRadius="10" Padding="16,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource CalcResultDecayConstant}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="λ = ln(2) / T½" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                           FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DecayConstantText}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <!-- النشاط الحالي A(t) — البطاقة الرئيسية -->
                    <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1AD4AF37" Offset="0"/>
                                <GradientStop Color="#0DD4AF37" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource CalcResultActivity}" FontSize="14"
                                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                <TextBlock Text="A(t) = A₀ × e⁻ˡᵗ" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"
                                           FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <!-- زر النسخ -->
                    <Button Content="{DynamicResource CalcBtnCopy}" Style="{DynamicResource SecondaryButton}"
                            Command="{Binding CopyResultCommand}" Width="130" Height="36"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══════ بطاقة المعادلات المرجعية ═══════ -->
            <Border Grid.Row="3" Style="{StaticResource ContentCard}" Padding="24,16" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="FunctionVariant" Width="20" Height="20"
                                                 Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource CalcFormulaTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <UniformGrid Columns="2">
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Step 1" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="λ = ln(2) / T½" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="16,12" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Step 2" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="A(t) = A₀ × e⁻ˡᵗ" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
