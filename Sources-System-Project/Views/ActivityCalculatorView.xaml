<UserControl x:Class="Sources.Views.ActivityCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Sources.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Stationary Standard Header -->
            <RowDefinition Height="*"/>    <!-- Row 1: Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- ═══════ 1. ترويسة الصفحة الموحدة (ثابتة في أعلى الصفحة) ═══════ -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,14" Background="{DynamicResource CardBackground}"
                CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Calculator" Width="32" Height="32" Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource CalcTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource CalcSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ 2. المحتوى القابل للتمرير ═══════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1000" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Mode Switcher -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Input Card -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Results KPI & Chart Cards -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Formulas Card -->
                </Grid.RowDefinitions>

                <!-- محوّل الوضعين الحسابيين -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="6" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource CalcTabCurrentActivity}"
                                     IsChecked="{Binding IsActivityMode}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,0,8,0" Padding="16,8"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"/>
                        <RadioButton Content="{DynamicResource CalcTabTimeToTarget}"
                                     IsChecked="{Binding IsTimeToTargetMode}"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Padding="16,8"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- بطاقة إدخال البيانات -->
                <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- نوع اختيار النظير -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="{DynamicResource CalcRadioFromDB}" IsChecked="{Binding IsFromDatabase}"
                                         Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,24,0"
                                         Foreground="{DynamicResource TextPrimary}"/>
                            <RadioButton Content="{DynamicResource CalcRadioManual}" IsChecked="{Binding IsManualInput}"
                                         Style="{StaticResource MaterialDesignRadioButton}"
                                         Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <!-- قائمة اختيار النظير المشع -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding IsFromDatabase, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource CalcFieldIsotope}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Isotopes}" SelectedItem="{Binding SelectedIsotope}"
                                      Style="{StaticResource FormComboBox}" FontSize="14"
                                      materialDesign:HintAssist.Hint="{DynamicResource CalcFieldIsotope}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="—" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- الحقول الرقمية: النشاط الأولي والوحدة -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource CalcFieldInitialActivity}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding InitialActivityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         materialDesign:HintAssist.Hint="{DynamicResource CalcHintActivity}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource CalcFieldInputUnit}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding InitialActivityUnit}"
                                          Style="{StaticResource FormComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- في وضع الزمن للنشاط المستهدف: حقل النشاط المستهدف ووحدته -->
                        <Grid Margin="0,0,0,14" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource CalcFieldTargetActivity}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding TargetActivityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         materialDesign:HintAssist.Hint="{DynamicResource CalcHintTargetActivity}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource CalcFieldInputUnit}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding TargetActivityUnit}"
                                          Style="{StaticResource FormComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- نصف العمر ووحدة الزمن -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource CalcFieldHalfLife}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding HalfLifeValueText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         IsReadOnly="{Binding IsFromDatabase}"
                                         materialDesign:HintAssist.Hint="{DynamicResource CalcHintHalfLife}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource CalcFieldTimeUnit}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding TimeUnits}" SelectedItem="{Binding HalfLifeUnit}"
                                          Style="{StaticResource FormComboBox}"
                                          IsEnabled="{Binding IsManualInput}"/>
                            </StackPanel>
                        </Grid>

                        <!-- التواريخ (تاريخ الصنع/المعايرة وتاريخ الحساب) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource CalcFieldCalibrationDate}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding CalibrationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            FontSize="13" FlowDirection="LeftToRight"
                                            materialDesign:HintAssist.Hint="yyyy/MM/dd"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource CalcFieldCalculationDate}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding CalculationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            FontSize="13" FlowDirection="LeftToRight"
                                            materialDesign:HintAssist.Hint="yyyy/MM/dd"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource CalcFieldOutputUnit}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding SelectedOutputUnit}"
                                          Style="{StaticResource FormComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- وحدة الخرج في وضع النشاط -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource CalcFieldOutputUnit}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ActivityUnits}" SelectedItem="{Binding SelectedOutputUnit}"
                                      Style="{StaticResource FormComboBox}"/>
                        </StackPanel>

                        <!-- رسائل الخطأ الدقيقة -->
                        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                Background="#1AD32F2F" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20"
                                                         Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- أزرار الإجراءات -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{DynamicResource CalcBtnCalculate}" Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding CalculateCommand}" Width="170" Height="44" Margin="0,0,16,0"
                                    Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{DynamicResource CalcBtnCalculateTime}" Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding CalculateCommand}" Width="170" Height="44" Margin="0,0,16,0"
                                    Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{DynamicResource CalcBtnReset}" Style="{DynamicResource SecondaryButton}"
                                    Command="{Binding ResetCommand}" Width="130" Height="44"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- بطاقة النتائج والرسم البياني -->
                <StackPanel Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                    <!-- بطاقات المؤشرات الرقمية (KPI Cards) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: النشاط المحسوب -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CalcResultActivity}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ResultActivityText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: النسبة المتبقية -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CalcResultRemainingPercent}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RemainingPercentText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 3: الزمن المنقضي / المطلوب -->
                        <Border Grid.Column="4" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CalcResultElapsed}" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource CalcResultRequiredTime}" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                
                                <TextBlock Text="{Binding ElapsedTimeText}" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{Binding RequiredTimeText}" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: فترات نصف العمر / التاريخ المتوقع -->
                        <Border Grid.Column="6" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CalcHalfLivesElapsed}" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource CalcResultTargetDate}" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding HalfLivesElapsedText}" Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{Binding TargetEstimatedDateText}" Visibility="{Binding IsTimeToTargetMode, Converter={StaticResource BoolToVis}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- بطاقة الرسم البياني لمنحنى الاضمحلال -->
                    <Border Style="{StaticResource ContentCard}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding HasChartData, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="260"/>
                            </Grid.RowDefinitions>

                            <!-- ترويسة الرسم ومفاتيحه -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource CalcChartTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- مفاتيح الرسم المخصصة -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ChartLegendItems}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- زر نسخ النتيجة -->
                                <Button Grid.Column="2" Content="{DynamicResource CalcBtnCopy}" Style="{DynamicResource SecondaryButton}"
                                        Command="{Binding CopyResultCommand}" Height="34" Padding="12,0"/>
                            </Grid>

                            <!-- الرسم البياني التفاعلي -->
                            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                                <lvc:CartesianChart Series="{Binding DecaySeries}"
                                                    XAxes="{Binding DecayXAxes}"
                                                    YAxes="{Binding DecayYAxes}"
                                                    DrawMargin="{Binding ChartDrawMargin}"
                                                    DrawMarginFrame="{Binding ChartDrawMarginFrame}"
                                                    LegendPosition="Hidden"
                                                    TooltipTextPaint="{Binding ChartTextPaint}"
                                                    TooltipBackgroundPaint="{Binding ChartTooltipBackgroundPaint}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- بطاقة المعادلات المرجعية -->
                <Border Grid.Row="3" Style="{StaticResource ContentCard}" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FunctionVariant" Width="20" Height="20"
                                                     Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource CalcFormulaTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Step 1 — Decay Constant" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="λ = ln(2) / T½" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"
                                               FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="14,10" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Step 2 — Radioactive Decay Law" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="A(t) = A₀ × (0.5)^(t / T½)" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"
                                               FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
