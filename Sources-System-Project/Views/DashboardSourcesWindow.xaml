<Window x:Class="Sources.Views.DashboardSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">
    <!-- الجولة 212: نافذة كاملة لمصادر صف مختار في رسوم لوحة التحكم (نطاق نشاط / نظير / موقع)
         بدل اللوحة الجانبية الضيقة. الأعمدة الرقمية ورموز النظائر من اليسار لليمين حتى لا تنقلب. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان والعدد -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="{DynamicResource PrimaryBrush}" Width="44" Height="44" CornerRadius="10" Padding="8">
                <materialDesign:PackIcon Kind="FormatListBulleted" Width="28" Height="28" Foreground="White"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CountText}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- الجدول -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="8">
            <DataGrid x:Name="SourcesGrid"
                      ItemsSource="{Binding Rows}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTemplateColumn Header="{DynamicResource ColSourceCode}" Width="Auto" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceCode}" FontWeight="Bold" TextAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" Cursor="Hand" TextDecorations="Underline"
                                           FlowDirection="LeftToRight">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.ViewSourceDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding Source}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource ColRadioisotopes}" Width="1.3*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayIsotopes}" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding LocationName}" Width="1.5*" MinWidth="150"
                                        ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="Auto" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource ColCurrentActivity}" Width="Auto" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentActivityDisplay}" HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight" Foreground="{DynamicResource TextPrimary}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource ColActivityUnit}" Width="Auto" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActivityUnitSymbol}" HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight" Foreground="{DynamicResource TextPrimary}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource ColDoseRate}" Width="Auto" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#141F5A66" CornerRadius="4" Padding="6,2" Margin="2,1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="{Binding DoseRateTooltip}">
                                    <TextBlock Text="{Binding DisplayDoseRate}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" TextAlignment="Center"
                                               FlowDirection="LeftToRight"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- إغلاق (Esc يغلق أيضاً) -->
        <Button Grid.Row="2" x:Name="CloseButton" Content="{DynamicResource BtnClose}" IsCancel="True"
                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="120" Margin="0,16,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
