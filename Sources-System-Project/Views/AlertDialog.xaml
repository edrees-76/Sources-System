<Window x:Class="Sources.Views.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sources - Alert" 
        SizeToContent="Height" 
        Width="520" MinWidth="460" MaxWidth="650"
        MinHeight="200" MaxHeight="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Border x:Name="MainBorder" CornerRadius="16" 
            Background="{DynamicResource CardBackground}" 
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.3" Color="#000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Dynamic Icon -->
            <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="16,16,0,0" Padding="25,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" 
                            Background="White" Opacity="0.2" Margin="0,0,12,0"/>
                    <materialDesign:PackIcon x:Name="AlertIcon" Grid.Column="0" Kind="Information" 
                                              Width="30" Height="30" Foreground="White"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="6,0,18,0"/>
                    
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{DynamicResource AlertTitle}" 
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="2" Click="CloseButton_Click"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            Width="30" Height="30" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Message Content -->
            <Border Grid.Row="1" Padding="25,20" MaxHeight="500">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Image Column -->
                        <ColumnDefinition Width="*"/>    <!-- Text Column -->
                    </Grid.ColumnDefinitions>

                    <!-- Image Container (Hidden by default) -->
                    <Border x:Name="ImageContainer" Grid.Column="0" Width="140" Height="140" 
                            CornerRadius="12" Margin="0,0,20,0" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Image x:Name="SourceImage" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,140,140"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" Text="رسالة النظام تظهر هنا..."
                                   FontSize="15" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" 
                                   VerticalAlignment="Top"
                                   LineHeight="26"
                                   TextAlignment="Right"
                                   FlowDirection="RightToLeft"
                                   Margin="0,0,1,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Padding="25,15" Background="{DynamicResource SidebarBackground}" CornerRadius="0,0,16,16">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="OkButton" Content="{DynamicResource BtnOk}" Click="OkButton_Click"
                            IsDefault="True" Width="100" Style="{StaticResource PrimaryButton}"/>
                    
                    <Button x:Name="YesButton" Content="{DynamicResource BtnYes}" Click="YesButton_Click"
                            Width="100" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
                    
                    <Button x:Name="NoButton" Content="{DynamicResource BtnNo}" Click="NoButton_Click"
                            Width="100" Style="{StaticResource SecondaryButton}" Foreground="White" BorderBrush="#55FFFFFF" Margin="12,0,0,0" Visibility="Collapsed"/>

                    <Button x:Name="CancelButton" Content="{DynamicResource BtnCancel}" Click="CancelButton_Click"
                            IsCancel="True" Width="100" Style="{StaticResource SecondaryButton}" Foreground="White" BorderBrush="#55FFFFFF" Margin="12,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
