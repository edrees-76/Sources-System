<Window x:Class="Sources.Views.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sources - Alert"
        SizeToContent="Height"
        Width="520" MinWidth="460" MaxWidth="650"
        MinHeight="200" MaxHeight="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" CornerRadius="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.3" Color="#000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: centered icon badge + title, close button top-right (login-card style) -->
            <Grid Grid.Row="0" Margin="0,22,0,14">
                <Button Click="CloseButton_Click"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        Width="30" Height="30" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,10,0">
                    <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16"/>
                </Button>

                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="IconBadge" Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <materialDesign:PackIcon x:Name="AlertIcon" Kind="Information"
                                                  Width="32" Height="32" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TitleText" Text="{DynamicResource AlertTitle}"
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Message Content -->
            <Border Grid.Row="1" Padding="25,4,25,20" MaxHeight="500">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Image Column -->
                        <ColumnDefinition Width="*"/>    <!-- Text Column -->
                    </Grid.ColumnDefinitions>

                    <!-- Image Container (Hidden by default) -->
                    <Border x:Name="ImageContainer" Grid.Column="0" Width="140" Height="140"
                            CornerRadius="12" Margin="0,0,20,0" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Image x:Name="SourceImage" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,140,140"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" Text="{DynamicResource PlaceholderAlertMessage}"
                                   FontSize="15" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Top"
                                   LineHeight="26"
                                   TextAlignment="Right"
                                   FlowDirection="RightToLeft"
                                   Margin="0,0,1,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Padding="25,0,25,22">
                <StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,16"/>
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="OkButton" Content="{DynamicResource BtnOk}" Click="OkButton_Click"
                                IsDefault="True" Width="100" Style="{StaticResource PrimaryButton}"/>

                        <Button x:Name="ExtraButton" Click="ExtraButton_Click"
                                MinWidth="130" Padding="14,0" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Visibility="Collapsed"/>

                        <Button x:Name="YesButton" Content="{DynamicResource BtnYes}" Click="YesButton_Click"
                                Width="100" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>

                        <Button x:Name="NoButton" Content="{DynamicResource BtnNo}" Click="NoButton_Click"
                                Width="100" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Visibility="Collapsed"/>

                        <Button x:Name="CancelButton" Content="{DynamicResource BtnCancel}" Click="CancelButton_Click"
                                IsCancel="True" Width="100" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
