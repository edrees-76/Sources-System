<Window x:Class="Sources.Views.LocationDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Sources.ViewModels"
        Title="{DynamicResource TitleLocationDetails}"
        Width="1200" Height="780"
        MinWidth="1050" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header (Title & Action Buttons) -->
            <RowDefinition Height="Auto"/> <!-- 2. Location Info Card -->
            <RowDefinition Height="Auto"/> <!-- 3. Radioactivity Summary Bar -->
            <RowDefinition Height="Auto"/> <!-- 4. Search & Filter Bar -->
            <RowDefinition Height="*"/>    <!-- 5. Linked Sources DataGrid / Empty State -->
            <RowDefinition Height="Auto"/> <!-- 6. Footer (Close Button & Status Count) -->
        </Grid.RowDefinitions>

        <!-- ════════ 1. Header ════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource PrimaryBrush}" Width="44" Height="44" CornerRadius="10" Padding="8">
                    <materialDesign:PackIcon Kind="MapMarkerRadius" Width="28" Height="28" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource TitleLocationDetails}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text=" — " FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding LocationName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource HeaderLinkedSources}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- زر تصدير PDF -->
                <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,10,0" Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="-4,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="{DynamicResource BtnExportPdf}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- زر تصدير Excel -->
                <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcelBox" Margin="-4,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="{DynamicResource BtnExportExcel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ════════ 2. Location Info Summary Card ════════ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <UniformGrid Columns="5">
                <!-- اسم الموقع -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource ColLocationName}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding LocationName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- نوع الموقع -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource ColType}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding LocationType, Converter={StaticResource LocationTypeToDisplay}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- المبنى -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource ColBuilding}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Building, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- الغرفة -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource ColRoom}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Room, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- المسؤول -->
                <StackPanel>
                    <TextBlock Text="{DynamicResource ColResponsible}" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding ResponsiblePerson, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ════════ 3. Radioactivity Summary Bar ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- عنوان الملخص -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <materialDesign:PackIcon Kind="Radioactive" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="إجمالي النشاط الإشعاعي بالموقع:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- كروت الوحدات المتعددة -->
                <ItemsControl ItemsSource="{Binding TotalActivityItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,6" Margin="4,0"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayValue}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ════════ 4. Search & Filter Bar ════════ -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- إحصائية النتائج في الجانب الأيسر -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="10,4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="المعروض: " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding FilteredSourcesCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text=" من " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalSourcesCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text=" مصدر" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. مربع البحث -->
                    <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8,4" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     materialDesign:HintAssist.Hint="{DynamicResource PlaceholderSearchLocationSources}"
                                     FontSize="13" VerticalAlignment="Center" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- 2. فلتر الحالة -->
                    <Border Grid.Column="1" Background="{DynamicResource InputBackground}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8,2" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="FilterOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      materialDesign:HintAssist.Hint="{DynamicResource FilterStatus}"
                                      FontSize="13" VerticalAlignment="Center" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- 3. زر مسح الفلاتر -->
                    <Button Grid.Column="2" Command="{Binding ClearFiltersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" Margin="-2,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource BtnClearFilters}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ════════ 5. DataGrid / Empty State ════════ -->
        <Grid Grid.Row="4">
            <!-- DataGrid عند وجود مصادر مطابقة -->
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource CardBackground}"
                    Visibility="{Binding HasFilteredSources, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding FilteredSources}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding DisplaySourceCode}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource BoldCenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColCalibrationDate}" Binding="{Binding CalibrationDate, StringFormat='yyyy-MM-dd'}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColSerialNumber}" Binding="{Binding SerialNumber, TargetNullValue='—'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>
                        <DataGridTextColumn Header="{DynamicResource ColManufacturer}" Binding="{Binding Manufacturer, TargetNullValue='—'}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterAligned}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State عند عدم وجود مصادر مطابقة -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="40"
                    Visibility="{Binding HasFilteredSources, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="DatabaseRemoveOutline" Width="56" Height="56" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource MsgNoSourcesMatchFilter}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                    <Button Command="{Binding ClearFiltersCommand}" Content="{DynamicResource BtnClearFilters}" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════ 6. Footer ════════ -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{DynamicResource BtnClose}" Style="{StaticResource SecondaryButton}"
                    Click="CloseButton_Click" Padding="28,8" Height="38" MinWidth="110" IsCancel="True">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                </Button.Effect>
            </Button>
        </DockPanel>
    </Grid>
</Window>
