<UserControl x:Class="Sources.Views.BorrowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Sources.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- شريط العنوان العلوي العام                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="20,16" Background="{DynamicResource CardBackground}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource BorrowingManagementTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource BorrowingManagementSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- أزرار الإجراءات العلوية -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Height="40" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource AddNewBorrowRequestTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Height="40" Width="40" Padding="0" ToolTip="{DynamicResource ExportExcel}" BorderBrush="{DynamicResource BorderColor}">
                        <materialDesign:PackIcon Kind="FileExcelBox" Width="22" Height="22" Foreground="#22C55E"/>
                    </Button>
                    <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" Width="40" Padding="0" ToolTip="{DynamicResource ExportPdf}" BorderBrush="{DynamicResource BorderColor}">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="22" Height="22" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- حاوية المشهد المزدوج (List ↔ Form)                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ─────────────────────────────────────────────────── -->
            <!-- المشهد 1: قائمة الاستعارات والبحث والإحصائيات       -->
            <!-- ─────────────────────────────────────────────────── -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- البطاقات الإحصائية -->
                    <RowDefinition Height="Auto"/> <!-- شريط البحث والتصفية -->
                    <RowDefinition Height="*"/>    <!-- جدول البيانات -->
                </Grid.RowDefinitions>

                <!-- البطاقات الإحصائية الأربع -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- إجمالي السجلات -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource TotalBorrows}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#144F7FA3" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BookSyncOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- جارية حالياً -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource ActiveBorrows}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding BorrowedCount}" FontSize="24" FontWeight="Bold" Foreground="#3FAE7A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#1A3FAE7A" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HandExtendedOutline" Width="22" Height="22" Foreground="#3FAE7A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- قريبة الإرجاع (7 أيام) -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource DueSoon}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding DueSoonCount}" FontSize="24" FontWeight="Bold" Foreground="#E0A93E" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#1AE0A93E" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockAlertOutline" Width="22" Height="22" Foreground="#E0A93E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- متأخرة -->
                    <Border Grid.Column="3" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource OverdueBorrows}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding OverdueCount}" FontSize="24" FontWeight="Bold" Foreground="#C25B4A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#1AC25B4A" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#C25B4A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- شريط البحث والتصفية -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="{DynamicResource SearchPlaceholder}"
                                     Width="320" Style="{StaticResource FormTextBox}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding PerformSearchCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource FilterByStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" 
                                      Width="160" Style="{StaticResource FormComboBox}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <b:InvokeCommandAction Command="{Binding PerformSearchCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>
                </Border>

                <!-- جدول سجل الاستعارات -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <DataGrid ItemsSource="{Binding Requests}" Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <!-- 1. الترقيم -->
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 2. كود المصدر -->
                            <DataGridTemplateColumn Header="{DynamicResource ColSourceCode}" Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplaySourceCode}"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Cursor="Hand"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextDecorations="Underline"
                                                   ToolTip="{DynamicResource ToolTipViewDetails}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.ViewSourceDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                              CommandParameter="{Binding Source}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. النظير -->
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 4. النشاط الحالي -->
                            <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 5. معدل الجرعة (1م) -->
                            <DataGridTemplateColumn Header="{DynamicResource ColDoseRate}" Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#141F5A66" CornerRadius="4" Padding="6,3" Margin="4,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="{Binding DoseRateTooltip}">
                                            <TextBlock Text="{Binding DisplayDoseRate}"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       TextAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. المستعير -->
                            <DataGridTextColumn Header="{DynamicResource ColBorrower}" Binding="{Binding DisplayBorrowerName}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 4. تاريخ الاستعارة -->
                            <DataGridTextColumn Header="{DynamicResource ColBorrowDate}" Binding="{Binding RequestDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 5. تاريخ الإرجاع المتوقع -->
                            <DataGridTextColumn Header="{DynamicResource ColExpectedReturn}" Binding="{Binding ExpectedReturnDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 6. تاريخ الإرجاع الفعلي -->
                            <DataGridTextColumn Header="{DynamicResource ColActualReturn}" Binding="{Binding ActualReturnDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='—'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 7. الغرض -->
                            <DataGridTextColumn Header="{DynamicResource ColPurpose}" Binding="{Binding Purpose}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- 8. الحالة -->
                            <DataGridTemplateColumn Header="{DynamicResource ColStatusAction}" Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A4F7FA3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                            <Setter Property="Background" Value="#1A3FAE7A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                            <Setter Property="Background" Value="#1A4F7FA3"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                            <Setter Property="Background" Value="#1AC25B4A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ArabicStatus}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                                <Setter Property="Foreground" Value="#3FAE7A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="#C25B4A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 9. الإجراءات -->
                            <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                Height="32" Padding="4" Width="32"
                                                ToolTip="{DynamicResource ToolTipActions}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

        </Grid>

    </Grid>
</UserControl>
