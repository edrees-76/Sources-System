<UserControl x:Class="Sources.Views.BorrowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:Sources.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="20" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource BorrowingManagementTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource BorrowingManagementSubtitle}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenCreateDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Height="40" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource AddNewBorrowRequest}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Height="40" ToolTip="{DynamicResource ExportExcel}" BorderBrush="{DynamicResource BorderColor}">
                        <materialDesign:PackIcon Kind="FileExcelBox" Width="20" Height="20" Foreground="#22C55E"/>
                    </Button>
                    <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" ToolTip="{DynamicResource ExportPdf}" BorderBrush="{DynamicResource BorderColor}">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics & Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cards -->
            <UniformGrid Grid.Column="0" Columns="3">
                <!-- Active Borrows -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12" Margin="0,0,8,0" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,3,0,0">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource ActiveBorrows}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ActiveCount}" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="Heavy" FontFamily="Segoe UI"/>
                            <TextBlock Text="{DynamicResource SourcesCountSuffix}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Due Soon -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12" Margin="4,0,4,0" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,3,0,0">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DueSoon}" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding DueSoonCount}" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="Heavy" FontFamily="Segoe UI"/>
                            <TextBlock Text="{DynamicResource SourcesCountSuffix}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Overdue -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12" Margin="8,0,0,0" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="0,3,0,0">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource OverdueRequests}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding OverdueCount}" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="Heavy" FontFamily="Segoe UI"/>
                            <TextBlock Text="{DynamicResource SourcesCountSuffix}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Search and Filter -->
            <Border Grid.Column="1" Padding="15" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                <StackPanel>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="{DynamicResource SearchBorrowHint}"
                             Style="{StaticResource SearchBox}" Margin="0,0,0,15">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="TextChanged">
                                <b:InvokeCommandAction Command="{Binding PerformSearchCommand}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="{DynamicResource StatusFilter}"
                              Style="{StaticResource FormComboBox}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding PerformSearchCommand}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{DynamicResource ContentCard}" Margin="0">
            <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding ActionRequest}" Style="{DynamicResource ModernDataGrid}"
                      HeadersVisibility="Column" CanUserResizeColumns="False" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="45" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding Source.SourceCode}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTextColumn Header="{DynamicResource ColBorrower}" Binding="{Binding BorrowerName}" Width="*" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTextColumn Header="{DynamicResource ColPurpose}" Binding="{Binding Purpose}" Width="1.5*" ElementStyle="{StaticResource NotesCellStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource ColBorrowDate}" Binding="{Binding RequestDate, StringFormat={}{0:yyyy/MM/dd}}" Width="115" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTextColumn Header="{DynamicResource ColReturnDate}" Binding="{Binding ExpectedReturnDate, StringFormat={}{0:yyyy/MM/dd}}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAligned}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource ColStatusAction}" Binding="{Binding ArabicStatus}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>
                    <DataGridTextColumn Header="{DynamicResource ColAddedBy}" Binding="{Binding AddedBy}" Width="120" ElementStyle="{StaticResource CenterAligned}"/>

                    <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PrepareActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource MaterialDesignToolForegroundButton}"
                                        Height="32" Padding="4" Width="32"
                                        ToolTip="{DynamicResource ToolTipActions}">
                                    <materialDesign:PackIcon Kind="Settings" Width="20" Height="20" Foreground="{DynamicResource GoldBrush}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Create Request Dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsCreateDialogOpen}" DialogMargin="8" Grid.RowSpan="3" Background="{DynamicResource CardBackground}">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="500" Margin="20" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{DynamicResource AddNewBorrowRequest}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,30">
                        <ComboBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSourceForNew}" 
                                  materialDesign:HintAssist.Hint="{DynamicResource SelectSource}" DisplayMemberPath="SourceCode"
                                  Style="{StaticResource FormComboBox}" Margin="0,0,0,10"/>
                                  
                        <!-- Source Info Card (Visible when source is selected) -->
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,8" Margin="0,0,0,15"
                                BorderBrush="#33D4AF37" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSourceInfo}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedSourceInfo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="معلومات المصدر:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedSourceInfo}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"
                                           TextAlignment="Right" FlowDirection="RightToLeft"/>
                            </StackPanel>
                        </Border>
                                  
                        <TextBox Text="{Binding NewBorrowerName, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="{DynamicResource SelectBorrower}"
                                 Style="{StaticResource FormTextBox}" Margin="0,0,0,15"/>
                                  
                        <TextBox Text="{Binding NewPurpose, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="{DynamicResource BorrowPurpose}" 
                                 Style="{StaticResource FormTextBox}" Margin="0,0,0,15" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                 
                        <DatePicker SelectedDate="{Binding NewExpectedReturnDate, UpdateSourceTrigger=PropertyChanged}" 
                                    materialDesign:HintAssist.Hint="{DynamicResource ExpectedReturn}" 
                                    Style="{StaticResource FormDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Cancel}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                                Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                        <Button Content="{DynamicResource SubmitRequest}" Command="{Binding SubmitCreateRequestCommand}" 
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Action Dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsActionDialogOpen}" DialogMargin="8" Grid.RowSpan="3" Background="{DynamicResource CardBackground}">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="450" Margin="20" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{DynamicResource RequestActions}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,30">
                        <TextBlock Text="{Binding ActionRequest.Source.SourceCode, StringFormat='المصدر: {0}'}" FontWeight="DemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ActionRequest.BorrowerName, StringFormat='المستعير: {0}'}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ActionRequest.ArabicStatus, StringFormat='الحالة الحالية: {0}'}" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <!-- أقسام الموافقة/الرفض والتسليم محذوفة - الاستعارة الآن فورية -->
                        <!-- يبقى فقط قسم الإرجاع (Return Section) للطلبات النشطة -->
                        
                        <!-- Return Section (Visible if Delivered or Overdue) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActionRequest.Status}" Value="Delivered">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionRequest.Status}" Value="Overdue">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
 
                            <ComboBox ItemsSource="{Binding AvailableBorrowers}" SelectedItem="{Binding SelectedReturnedBy}" 
                                      materialDesign:HintAssist.Hint="{DynamicResource SelectedReturnedBy}" DisplayMemberPath="FullName"
                                      Style="{StaticResource FormComboBox}" Margin="0,0,0,20"/>
 
                            <Button Content="{DynamicResource MarkReturned}" Command="{Binding ExecuteReturnCommand}" 
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                    </StackPanel>

                    <Button Grid.Row="2" Content="{DynamicResource Close}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                            Foreground="{DynamicResource TextPrimary}"
                            Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right"/>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</UserControl>
