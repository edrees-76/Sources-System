<UserControl x:Class="Sources.Views.LeakTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Sources.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <Grid Margin="24">

        <!-- ─── المحتوى الرئيسي ─── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- ترويسة الصفحة والتحكم -->
                <RowDefinition Height="*"/>    <!-- جدول السجلات -->
                <RowDefinition Height="Auto"/> <!-- شريط الصفحات -->
            </Grid.RowDefinitions>

            <!-- ─── شريط الترويسة والفلترة ─── -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" 
                    CornerRadius="12" Padding="16" Margin="0,0,0,16" 
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- الصف العلوي: العنوان والأزرار الرئيسية -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <!-- العنوان والأيقونة -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#141F5A66" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="22" Height="22" 
                                                         Foreground="{DynamicResource PrimaryBrush}" 
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource MenuLeakTests}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource SubtitleLeakTests}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- أزرار الإجراءات والتصدير -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- زر تسجيل فحص جديد -->
                            <Button Command="{Binding OpenAddModalCommand}"
                                    Style="{DynamicResource PrimaryButton}"
                                    Height="38" Padding="16,0" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnAddLeakTest}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- زر تصدير PDF -->
                            <Button Command="{Binding ExportToPdfCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}"
                                    Height="38" Margin="6,0,0,0" Padding="12,0"
                                    ToolTip="{DynamicResource ToolTipExportPdf}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PDF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- زر تصدير Excel -->
                            <Button Command="{Binding ExportToExcelCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}"
                                    Height="38" Margin="6,0,0,0" Padding="12,0"
                                    ToolTip="{DynamicResource ToolTipExportExcel}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelBox" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Excel" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- زر التحديث -->
                            <Button Command="{Binding LoadDataCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Height="36" Width="36" Margin="4,0,0,0" Padding="0"
                                    ToolTip="{DynamicResource ToolTipRefresh}">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- الصف السفلي: شريط البحث والتصفية -->
                    <DockPanel Grid.Row="1">
                        <!-- مربع البحث -->
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="280" DockPanel.Dock="Left"
                                 Style="{DynamicResource SearchBox}" 
                                 materialDesign:HintAssist.Hint="{DynamicResource HintSearchLeakTests}"
                                 BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PrimaryBrush}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                DockPanel.Dock="Left" Margin="4,0,16,0" Padding="4" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>

                        <!-- فلتر النتيجة -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LabelResultFilter}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox SelectedValue="{Binding ResultFilter, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource CompactComboBox}" Width="130">
                                <ComboBoxItem Content="{DynamicResource FilterAll}" Tag="All"/>
                                <ComboBoxItem Content="{DynamicResource ResultPass}" Tag="Pass"/>
                                <ComboBoxItem Content="{DynamicResource ResultFail}" Tag="Fail"/>
                                <ComboBoxItem Content="{DynamicResource ResultInconclusive}" Tag="Inconclusive"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- فلتر حالة الاستحقاق -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LabelDueStatusFilter}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox SelectedValue="{Binding DueStatusFilter, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource CompactComboBox}" Width="130">
                                <ComboBoxItem Content="{DynamicResource FilterAll}" Tag="All"/>
                                <ComboBoxItem Content="{DynamicResource DueStatusDueSoon}" Tag="DueSoon"/>
                                <ComboBoxItem Content="{DynamicResource DueStatusOverdue}" Tag="Overdue"/>
                                <ComboBoxItem Content="{DynamicResource DueStatusValid}" Tag="Valid"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- زر إعادة تعيين البحث -->
                        <Button Command="{Binding ResetSearchCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                DockPanel.Dock="Right" Height="32" Padding="12,0"
                                BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOff" Width="15" Height="15" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource BtnReset}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ─── جدول البيانات ─── -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0" Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid ItemsSource="{Binding PagedRecords}" 
                              Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}"
                              AlternationCount="1000">
                        <DataGrid.Columns>
                            <!-- الترقيم التسلسلي -->
                            <DataGridTemplateColumn Header="#" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CenterAligned}" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource RowIndexConverter}">
                                                    <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                    <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="DataContext.PageSize" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!-- كود المصدر -->
                            <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding Source.SourceCode}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource BoldCenterAligned}"/>

                            <!-- النظائر -->
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding Source.DisplayIsotopes}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- تاريخ الفحص -->
                            <DataGridTextColumn Header="{DynamicResource ColTestDate}" Binding="{Binding TestDate, StringFormat='yyyy-MM-dd'}" Width="Auto" MinWidth="115" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- تاريخ الاستحقاق القادم -->
                            <DataGridTextColumn Header="{DynamicResource ColNextDueDate}" Binding="{Binding NextDueDate, StringFormat='yyyy-MM-dd'}" Width="Auto" MinWidth="125" ElementStyle="{StaticResource BoldCenterAligned}"/>

                            <!-- نتيجة الفحص -->
                            <DataGridTemplateColumn Header="{DynamicResource ColResult}" Width="Auto" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A4F7FA3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                            <Setter Property="Background" Value="#1A2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                            <Setter Property="Background" Value="#1AC25B4A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Result}" Value="Inconclusive">
                                                            <Setter Property="Background" Value="#1AE0A93E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ArabicResult}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Inconclusive">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- النشاط المقاس (Bq) -->
                            <DataGridTextColumn Header="{DynamicResource ColMeasuredActivity}" Binding="{Binding MeasuredActivityBq, StringFormat='{}{0:N2} Bq', TargetNullValue='—'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- القائم بالفحص / المفتش -->
                            <DataGridTextColumn Header="{DynamicResource ColInspector}" Binding="{Binding InspectorName, TargetNullValue='—'}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource SubtleCenterAligned}"/>

                            <!-- رقم الشهادة -->
                            <DataGridTextColumn Header="{DynamicResource ColCertificateNumber}" Binding="{Binding CertificateNumber, TargetNullValue='—'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterAligned}"/>

                            <!-- الإجراءات -->
                            <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- عرض التفاصيل -->
                                            <Button Command="{Binding DataContext.ViewRecordDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Padding="4" Height="28" Width="28"
                                                    Foreground="{DynamicResource GoldBrush}"
                                                    ToolTip="{DynamicResource ToolTipViewDetails}">
                                                <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
                                            </Button>

                                            <!-- تعديل -->
                                            <Button Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Padding="4" Height="28" Width="28"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    ToolTip="{DynamicResource CtxEdit}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                            </Button>

                                            <!-- حذف -->
                                            <Button Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Padding="4" Height="28" Width="28"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    ToolTip="{DynamicResource CtxDelete}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- حالة فارغة عند عدم وجود سجلات -->
                    <Border Background="{DynamicResource CardBackground}" Padding="40"
                            Visibility="{Binding HasRecords, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="56" Height="56" Foreground="{DynamicResource TextSecondary}" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource EmptyLeakTestsTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource EmptyLeakTestsSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <Button Command="{Binding OpenAddModalCommand}" Style="{DynamicResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,16,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnAddLeakTest}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── شريط الصفحات ─── -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" 
                    CornerRadius="0,0,10,10" Padding="16,10" 
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" 
                    Margin="0,6,0,0"
                    Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="{Binding PageStatusText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Command="{Binding FirstPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnFirstPage}">
                            <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnPrevious}">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="12,4" Margin="4,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="CurrentPage"/>
                                        <Binding Path="TotalPages"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnNext}">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding LastPageCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32" Padding="4" ToolTip="{DynamicResource BtnLastPage}">
                            <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ─── نافذة منبثقة لتسجيل / تعديل فحص التسرب (Modal Overlay) ─── -->
        <Grid Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}" 
              Background="#88000000" Margin="-24" Panel.ZIndex="100">
            <Border Width="560" MaxHeight="640" Background="{DynamicResource CardBackground}"
                    CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- ترويسة المودال -->
                        <RowDefinition Height="*"/>    <!-- نموذج الإدخال -->
                        <RowDefinition Height="Auto"/> <!-- أزرار الحفظ والإلغاء -->
                    </Grid.RowDefinitions>

                    <!-- ترويسة المودال -->
                    <Border Grid.Row="0" Background="#141F5A66" CornerRadius="12,12,0,0" Padding="20,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button Command="{Binding CloseModalCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32" Height="32" Padding="0" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextSecondary}" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldEditOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- محتوى النموذج -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                        <StackPanel>
                            <!-- اختيار المصدر المشع -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource FieldSourceCodeReq}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding SealedSources}"
                                          SelectedValue="{Binding FormSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="SourceCode"
                                          IsEnabled="{Binding IsEditingRecord, Converter={StaticResource InverseBoolConverter}}"
                                          Style="{StaticResource FormComboBox}"/>
                            </StackPanel>

                            <!-- تواريخ الفحص والاستحقاق القادم -->
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <!-- تاريخ الفحص -->
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource FieldTestDateReq}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FormTestDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource FormDatePicker}"/>
                                </StackPanel>

                                <!-- تاريخ الاستحقاق القادم (محسوب تلقائياً مع إمكانية التعديل) -->
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource FieldNextDueDateReq}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FormNextDueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource FormDatePicker}"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- النتيجة والنشاط المقاس -->
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <!-- نتيجة الفحص -->
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource FieldResultReq}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox SelectedValue="{Binding FormResult, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FormComboBox}">
                                        <ComboBoxItem Content="{DynamicResource ResultPass}" Tag="Pass"/>
                                        <ComboBoxItem Content="{DynamicResource ResultFail}" Tag="Fail"/>
                                        <ComboBoxItem Content="{DynamicResource ResultInconclusive}" Tag="Inconclusive"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- النشاط المقاس (Bq) -->
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource FieldMeasuredActivity}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding FormMeasuredActivityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="0.00 Bq" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- المفتش ورقم الشهادة -->
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <!-- اسم المفتش / الفاحص -->
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource FieldInspectorName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding FormInspectorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="د. أحمد علي"/>
                                </StackPanel>

                                <!-- رقم شهادة الفحص -->
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource FieldCertificateNumber}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding FormCertificateNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="CERT-2026-001" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- ملاحظات الفحص -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource FieldNotes}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FormNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         AcceptsReturn="True" MinLines="2" MaxLines="3" TextWrapping="Wrap"
                                         materialDesign:HintAssist.Hint="أي ملاحظات حول إجراءات المسح والمسحة القطنية..."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- أزرار الحفظ والإلغاء -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding SaveRecordCommand}" Style="{DynamicResource PrimaryButton}" Height="38" Padding="24,0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BtnSaveData}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseModalCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="18,0" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextSecondary}">
                                <TextBlock Text="{DynamicResource BtnCancel}" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
