<Window x:Class="Sources.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="مصادر | Sources" Height="480" Width="620">
    <Border Background="#0B1320" CornerRadius="16" BorderBrush="#D4AF37" BorderThickness="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App Logo Badge -->
            <Border Grid.Row="0" Width="130" Height="130" CornerRadius="65" Background="White" BorderBrush="#D4AF37" BorderThickness="2" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#D4AF37" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <Image Source="pack://siteoforigin:,,,/Assets/sources_logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- App Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="10,5,10,15">
                <TextBlock Text="مــصــادر | SOURCES" FontSize="26" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center"/>
                <TextBlock Text="منظومة إدارة وتتبع المصادر والنظائر المشعة" FontSize="16" Foreground="#7FC3E8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Loading Progress -->
            <ProgressBar Grid.Row="2" x:Name="ProgressBar" Height="6" Background="#162235" Foreground="#D4AF37" IsIndeterminate="False" Minimum="0" Maximum="100" Value="10" Margin="40,10,40,10" BorderThickness="0" />

            <!-- Status Text -->
            <TextBlock Grid.Row="3" x:Name="TxtStatus" Text="جاري تهيئة منظومة مصادر وقاعدة البيانات..." Foreground="#9FB2CC" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Credits Footer -->
            <StackPanel Grid.Row="4" Margin="0,5,0,0">
                <Separator Background="#162235" Margin="40,0,40,10" />
                <TextBlock Text="تصميم و تطوير و تنفيذ" Foreground="#9FB2CC" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Text="م . ادريس فتح الله الهرى" Foreground="#D4AF37" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="م . رضا المريمى" Foreground="#D4AF37" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
