<Window x:Class="Sources.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sources - Password Verification" 
        SizeToContent="Height" 
        Width="480" MinWidth="440" MaxWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.92" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Border x:Name="MainBorder" CornerRadius="16" 
            Background="{DynamicResource CardBackground}" 
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.35" Color="#000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ─── Header with Gradient & Security Icon ─── -->
            <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="16,16,0,0" Padding="24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" 
                            Background="White" Opacity="0.2" Margin="0,0,12,0"/>
                    <materialDesign:PackIcon x:Name="SecurityIcon" Grid.Column="0" Kind="ShieldLockOutline" 
                                              Width="26" Height="26" Foreground="White"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="8,0,20,0"/>
                    
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{DynamicResource TitleAdminPasswordRequired}" 
                               FontSize="17" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="2" Click="CloseButton_Click"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            Width="30" Height="30" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- ─── Body Content: Prompt & Password Input ─── -->
            <Border Grid.Row="1" Padding="25,22,25,18">
                <StackPanel>
                    <!-- Prompt Text -->
                    <TextBlock x:Name="PromptText" 
                               Text="{DynamicResource PromptAdminPasswordRequired}"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" 
                               LineHeight="22"
                               Margin="0,0,0,16"/>

                    <!-- Password Box Container -->
                    <Border Background="{DynamicResource MainBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="12,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="KeyVariant" 
                                                    Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <PasswordBox x:Name="TxtPassword" Grid.Column="1"
                                         FontSize="15"
                                         FontFamily="Segoe UI"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         Padding="4,8"
                                         PasswordChar="●"
                                         KeyDown="TxtPassword_KeyDown"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- ─── Footer with Confirm / Cancel Buttons ─── -->
            <Border Grid.Row="2" Padding="24,15" Background="{DynamicResource SidebarBackground}" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ConfirmButton" 
                            Content="{DynamicResource BtnConfirm}" 
                            Click="ConfirmButton_Click"
                            IsDefault="True" 
                            Width="110" 
                            Style="{StaticResource PrimaryButton}"/>
                    
                    <Button x:Name="CancelButton" 
                            Content="{DynamicResource BtnCancel}" 
                            Click="CancelButton_Click"
                            IsCancel="True" 
                            Width="100" 
                            Style="{StaticResource SecondaryButton}" 
                            Foreground="White" 
                            BorderBrush="#55FFFFFF" 
                            Margin="14,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
