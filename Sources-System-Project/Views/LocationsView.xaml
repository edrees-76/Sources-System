<UserControl x:Class="Sources.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="MapMarkerRadius" Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource LocationsManagementTitle}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource LocationsManagementSubtitle}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource BtnAddLocation}" Style="{StaticResource PrimaryButton}" Command="{Binding AddNewCommand}" Margin="0,0,8,0">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="{StaticResource PrimaryColor}"/>
                    </Button.Effect>
                </Button>
                
                <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,8,0" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnExportPdf}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcelBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnExportExcel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- بانر الإشعار والرسائل التفاعلية -->
        <Border Grid.Row="1" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CloseMessageCommand}" Width="28" Height="28" Padding="0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource ContentCard}" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding Selected}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                        
                        <!-- اسم الموقع -->
                        <DataGridTextColumn Header="{DynamicResource ColLocationName}" Binding="{Binding LocationName}" Width="180" ElementStyle="{StaticResource BoldCenterAligned}"/>

                        <!-- النوع -->
                        <DataGridTextColumn Header="{DynamicResource ColType}" Binding="{Binding LocationType, Converter={StaticResource LocationTypeToDisplay}}" Width="120" ElementStyle="{StaticResource SecondaryCenterAligned}"/>

                        <!-- عدد المصادر -->
                        <DataGridTemplateColumn Header="{DynamicResource ColSourceCount}" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackground}" CornerRadius="10" Padding="8,3" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Radioactive" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SourceCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- المبنى -->
                        <DataGridTextColumn Header="{DynamicResource ColBuilding}" Binding="{Binding Building, TargetNullValue='—'}" Width="140" ElementStyle="{StaticResource CenterAligned}"/>

                        <!-- الغرفة -->
                        <DataGridTextColumn Header="{DynamicResource ColRoom}" Binding="{Binding Room, TargetNullValue='—'}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>

                        <!-- المسؤول -->
                        <DataGridTextColumn Header="{DynamicResource ColResponsible}" Binding="{Binding ResponsiblePerson, TargetNullValue='—'}" Width="150" ElementStyle="{StaticResource CenterAligned}"/>

                        <!-- أضيف بواسطة -->
                        <DataGridTextColumn Header="{DynamicResource ColAddedBy}" Binding="{Binding AddedBy, TargetNullValue='—'}" Width="120" ElementStyle="{StaticResource SubtleCenterAligned}"/>

                        <!-- عمود الإجراءات -->
                        <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- عرض التفاصيل -->
                                        <Button Command="{Binding DataContext.ViewLocationDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                Padding="4" Height="30" Width="30"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                ToolTip="{DynamicResource ToolTipLocationDetails}">
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                        </Button>
                                        <!-- تعديل -->
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                Padding="4" Height="30" Width="30"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                ToolTip="{DynamicResource CtxEdit}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <!-- حذف -->
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                Padding="4" Height="30" Width="30"
                                                Foreground="{DynamicResource DangerBrush}"
                                                ToolTip="{DynamicResource CtxDelete}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}">
                            <MenuItem Header="{DynamicResource ToolTipLocationDetails}" Command="{Binding ViewLocationDetailsCommand}" CommandParameter="{Binding Selected}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Eye" Foreground="{DynamicResource PrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource CtxEdit}" Command="{Binding EditCommand}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PencilOutline" Foreground="{DynamicResource PrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource CtxDelete}" Command="{Binding DeleteCommand}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="{DynamicResource DangerBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
            <Border Style="{StaticResource ContentCard}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <Border.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                </Border.InputBindings>
                <StackPanel MaxWidth="500">
                    <TextBlock Text="{DynamicResource LocationDataTitle}" Style="{StaticResource CardTitle}" FontSize="20" Margin="0,0,0,20"/>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource FieldNameReq}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName}" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource FieldType}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding EditType}" SelectedValuePath="Tag" Style="{StaticResource FormComboBox}">
                                <ComboBoxItem Content="{DynamicResource LocationTypeLab}" Tag="Lab" Foreground="{DynamicResource TextPrimary}" Padding="10,8" FontFamily="Segoe UI" FontSize="14"/>
                                <ComboBoxItem Content="{DynamicResource LocationTypeStorage}" Tag="Storage" Foreground="{DynamicResource TextPrimary}" Padding="10,8" FontFamily="Segoe UI" FontSize="14"/>
                                <ComboBoxItem Content="{DynamicResource LocationTypeHospital}" Tag="Hospital" Foreground="{DynamicResource TextPrimary}" Padding="10,8" FontFamily="Segoe UI" FontSize="14"/>
                                <ComboBoxItem Content="{DynamicResource LocationTypeClinic}" Tag="Clinic" Foreground="{DynamicResource TextPrimary}" Padding="10,8" FontFamily="Segoe UI" FontSize="14"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FieldBuilding}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditBuilding}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource FieldRoom}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditRoom}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FieldResponsible}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPerson}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="{DynamicResource BtnSave}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0,0,12,0"/>
                        <Button Content="{DynamicResource BtnCancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── لوحة تفاصيل الموقع المنبثقة (Location Details Overlay) ─── -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Margin="-24"
              Visibility="{Binding IsLocationDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    MaxWidth="920" MaxHeight="620" Margin="24" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header (Title & Close) -->
                        <RowDefinition Height="Auto"/> <!-- Location Info Summary -->
                        <RowDefinition Height="Auto"/> <!-- Section Title -->
                        <RowDefinition Height="*"/>    <!-- Linked Sources Table or Empty State -->
                        <RowDefinition Height="Auto"/> <!-- Footer Button -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MapMarkerRadius" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource TitleLocationDetails}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CloseLocationDetailsCommand}" HorizontalAlignment="Left" Width="30" Height="30">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </DockPanel>

                    <!-- 2. Location Info Summary Card -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource ColLocationName}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SelectedLocationForDetails.LocationName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource ColType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SelectedLocationForDetails.LocationType, Converter={StaticResource LocationTypeToDisplay}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource ColBuilding}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SelectedLocationForDetails.Building, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ColResponsible}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding SelectedLocationForDetails.ResponsiblePerson, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- 3. Section Title -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Radioactive" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource HeaderLinkedSources}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LinkedSourcesForDetails.Count}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- 4. Sources DataGrid or Empty State -->
                    <Grid Grid.Row="3">
                        <!-- DataGrid if Sources exist -->
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                                Visibility="{Binding HasLinkedSources, Converter={StaticResource BoolToVis}}">
                            <DataGrid ItemsSource="{Binding LinkedSourcesForDetails}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="350">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding DisplaySourceCode}" Width="130" ElementStyle="{StaticResource BoldCenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="140" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCalibrationDate}" Binding="{Binding CalibrationDate, StringFormat='yyyy-MM-dd'}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColSerialNumber}" Binding="{Binding SerialNumber, TargetNullValue='—'}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColManufacturer}" Binding="{Binding Manufacturer, TargetNullValue='—'}" Width="*" ElementStyle="{StaticResource CenterAligned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Empty State if no linked sources -->
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="30"
                                Visibility="{Binding HasLinkedSources, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseRemoveOutline" Width="48" Height="48" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource MsgNoSourcesLinkedToLocation}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 5. Footer -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Content="{DynamicResource BtnClose}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseLocationDetailsCommand}" Padding="24,8" Height="38" MinWidth="110">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
