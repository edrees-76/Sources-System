<Window x:Class="Sources.Views.ChangeOwnPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource TitleChangeOwnPassword}" 
        SizeToContent="Height" 
        Width="480" MinWidth="440" MaxWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.92" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Border x:Name="MainBorder" CornerRadius="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.35" Color="#000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: centered icon badge + title, close button top-right (login-card style) -->
            <Grid Grid.Row="0" Margin="0,22,0,14">
                <Button Click="CloseButton_Click"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        Width="30" Height="30" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,10,0">
                    <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16"/>
                </Button>

                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="IconBadge" Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <materialDesign:PackIcon x:Name="SecurityIcon" Kind="KeyChange"
                                                  Width="32" Height="32" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TitleText" Text="{DynamicResource TitleChangeOwnPassword}"
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ─── Body Content: current / new / confirm passwords ─── -->
            <Border Grid.Row="1" Padding="25,4,25,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LabelCurrentPassword}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource MainBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="12,4"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="KeyVariant"
                                                    Width="20" Height="20"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <PasswordBox x:Name="TxtCurrentPassword" Grid.Column="1"
                                         FontSize="15"
                                         FontFamily="Segoe UI"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         Padding="4,8"
                                         PasswordChar="●"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource LabelNewPassword}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource MainBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="12,4"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="LockReset"
                                                    Width="20" Height="20"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <PasswordBox x:Name="TxtNewPassword" Grid.Column="1"
                                         FontSize="15"
                                         FontFamily="Segoe UI"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         Padding="4,8"
                                         PasswordChar="●"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource LabelConfirmNewPassword}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource MainBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="12,4"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="LockCheckOutline"
                                                    Width="20" Height="20"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <PasswordBox x:Name="TxtConfirmPassword" Grid.Column="1"
                                         FontSize="15"
                                         FontFamily="Segoe UI"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         Padding="4,8"
                                         PasswordChar="●" KeyDown="TxtConfirmPassword_KeyDown"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="13" TextWrapping="Wrap"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ─── Footer with Confirm / Cancel Buttons ─── -->
            <Border Grid.Row="2" Padding="25,0,25,22">
                <StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ConfirmButton"
                                Content="{DynamicResource BtnConfirm}"
                                Click="ConfirmButton_Click"
                                IsDefault="True"
                                Width="110"
                                Style="{StaticResource PrimaryButton}"/>

                        <Button x:Name="CancelButton"
                                Content="{DynamicResource BtnCancel}"
                                Click="CancelButton_Click"
                                IsCancel="True"
                                Width="100"
                                Style="{StaticResource SecondaryButton}"
                                Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
