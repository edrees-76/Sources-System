<Window x:Class="Sources.Views.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource FirstRunWizardTitle}"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            Margin="1">
        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{DynamicResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="CogOutline"
                                              Width="28" Height="28" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource FirstRunWizardTitle}"
                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Welcome text -->
            <TextBlock Grid.Row="1" Text="{DynamicResource FirstRunWizardWelcome}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,18"/>

            <!-- Body -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource FirstRunWizardBackupPathLabel}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Left" Content="{DynamicResource BtnBrowse}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseFolderCommand}" Margin="0,0,12,0"
                            Padding="16,8"/>
                    <TextBox Text="{Binding BackupPath, Mode=TwoWay}" IsReadOnly="True"
                             Style="{StaticResource FormTextBox}"
                             VerticalContentAlignment="Center" FontSize="13"/>
                </DockPanel>

                <DockPanel>
                    <TextBlock Text="{DynamicResource FirstRunWizardAutoBackupLabel}" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <ToggleButton DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="0,0,16,0"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding AutoBackupEnabled}"/>
                </DockPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{DynamicResource FirstRunWizardFinishButton}"
                            Command="{Binding FinishCommand}"
                            IsDefault="True"
                            Width="140"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button Content="{DynamicResource FirstRunWizardSkipButton}"
                            Command="{Binding SkipCommand}"
                            Width="120"
                            Style="{StaticResource SecondaryButton}"
                            Margin="14,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
