<UserControl x:Class="Sources.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- النمط الأساسي لأزرار تبويبات التقارير -->
        <Style x:Key="ReportTabButtonBase" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: تفتيح خفيف للخلفية مع تمييز الحدود بلون Primary خفيف -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DataGridRowHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GeneralReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="GeneralReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="InventoryReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BorrowingReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="BorrowingReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="ActivityReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LowActivityReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="LowActivityReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LowActivityAlertReportTabBtn" TargetType="Button" BasedOn="{StaticResource ReportTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReport}" Value="LowActivityAlertReport">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Right">
                <!-- أزرار التقارير بتصميم موحد وتأثير تفاعلي للتبويب النشط والتحويم -->
                <WrapPanel Margin="0,0,0,0">
                    <Button Content="{DynamicResource BtnGeneralReport}" Style="{StaticResource GeneralReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="GeneralReport"/>
                    <Button Content="{DynamicResource BtnInventoryReport}" Style="{StaticResource InventoryReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="InventoryReport"/>
                    <Button Content="{DynamicResource BtnBorrowingReport}" Style="{StaticResource BorrowingReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="BorrowingReport"/>
                    <Button Content="{DynamicResource BtnActivityReport}" Style="{StaticResource ActivityReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="ActivityReport"/>
                    <Button Content="{DynamicResource BtnLowActivityReport}" Style="{StaticResource LowActivityReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="LowActivityReport"/>
                    <Button Content="{DynamicResource BtnCalibrationReport}" Style="{StaticResource LowActivityAlertReportTabBtn}"
                            Command="{Binding SelectReportCommand}" CommandParameter="LowActivityAlertReport"/>
                </WrapPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Button Command="{Binding ExportToPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnExportPdf}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcelBox" Margin="-4,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BtnExportExcel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}">
            <Grid>
                <!-- التقرير العام الشامل -->
                <ScrollViewer Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=GeneralReport}"
                              VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                    <StackPanel Margin="0,0,16,16">
                        <!-- 1. جرد المصادر -->
                        <TextBlock Text="{DynamicResource GeneralReportSectionInventory}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <DataGrid ItemsSource="{Binding InventoryData}" Style="{StaticResource ModernDataGrid}" MaxHeight="350" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColInitialActivity}" Binding="{Binding InitialActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding Location.LocationName}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status, Converter={StaticResource StatusToArabic}}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Visibility="{Binding InventoryData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                                    Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2. الاستعارات -->
                        <TextBlock Text="{DynamicResource GeneralReportSectionBorrowing}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <DataGrid ItemsSource="{Binding BorrowingData}" Style="{StaticResource ModernDataGrid}" MaxHeight="350" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding Source.SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColBorrowerName}" Binding="{Binding DisplayBorrowerName}" Width="150" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColRequestDate}" Binding="{Binding RequestDate, StringFormat=d}" Width="120" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColExpectedReturn}" Binding="{Binding ExpectedReturnDate, StringFormat=d}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Visibility="{Binding BorrowingData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                                    Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3. المصادر المنخفضة -->
                        <TextBlock Text="{DynamicResource GeneralReportSectionLowActivity}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <DataGrid ItemsSource="{Binding LowActivityData}" Style="{StaticResource ModernDataGrid}" MaxHeight="350" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding Location.LocationName}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Visibility="{Binding LowActivityData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                                    Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 4. تنبيهات انخفاض النشاط -->
                        <TextBlock Text="{DynamicResource GeneralReportSectionAlerts}" FontSize="18" FontWeight="SemiBold" Foreground="Red" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding LowActivityAlertData}" Style="{StaticResource ModernDataGrid}" MaxHeight="350" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding AlertWorstIsotope}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTemplateColumn Header="{DynamicResource ColSeverityBadge}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding AlertSeverity, Converter={StaticResource SeverityToColor}}"
                                                        CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AlertSeverityDisplay}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource ColCalibration}" Binding="{Binding CalibrationDate, StringFormat=d}" Width="120" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                                    <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Visibility="{Binding LowActivityAlertData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                                    Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- تقرير الجرد -->
                <Grid Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=InventoryReport}">
                    <DataGrid ItemsSource="{Binding InventoryData}" Style="{StaticResource ModernDataGrid}" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColInitialActivity}" Binding="{Binding InitialActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding Location.LocationName}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status, Converter={StaticResource StatusToArabic}}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Visibility="{Binding InventoryData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- تقرير الاستعارة -->
                <Grid Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=BorrowingReport}">
                    <DataGrid ItemsSource="{Binding BorrowingData}" Style="{StaticResource ModernDataGrid}" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColSourceCode}" Binding="{Binding Source.SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColBorrowerName}" Binding="{Binding DisplayBorrowerName}" Width="150" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColRequestDate}" Binding="{Binding RequestDate, StringFormat=d}" Width="120" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColExpectedReturn}" Binding="{Binding ExpectedReturnDate, StringFormat=d}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="100" ElementStyle="{StaticResource CenterAligned}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Visibility="{Binding BorrowingData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- تقرير النشاط -->
                <Grid Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=ActivityReport}">
                    <DataGrid ItemsSource="{Binding ActivityData}" Style="{StaticResource ModernDataGrid}" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColInitialActivity}" Binding="{Binding InitialActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCalibration}" Binding="{Binding CalibrationDate, StringFormat=d}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Visibility="{Binding ActivityData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- تقرير المصادر المنخفضة -->
                <Grid Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=LowActivityReport}">
                    <DataGrid ItemsSource="{Binding LowActivityData}" Style="{StaticResource ModernDataGrid}" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding DisplayIsotopes}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColLocation}" Binding="{Binding Location.LocationName}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Visibility="{Binding LowActivityData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- تقرير تنبيهات انخفاض النشاط -->
                <Grid Visibility="{Binding SelectedReport, Converter={StaticResource EqualityToVis}, ConverterParameter=LowActivityAlertReport}">
                    <DataGrid ItemsSource="{Binding LowActivityAlertData}" Style="{StaticResource ModernDataGrid}" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Converter={StaticResource IndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Width="50" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCode}" Binding="{Binding SourceCode}" Width="100" ElementStyle="{StaticResource BoldCenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColIsotope}" Binding="{Binding AlertWorstIsotope}" Width="90" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTemplateColumn Header="{DynamicResource ColSeverityBadge}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding AlertSeverity, Converter={StaticResource SeverityToColor}}"
                                                CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AlertSeverityDisplay}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource ColCalibration}" Binding="{Binding CalibrationDate, StringFormat=d}" Width="120" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding ArabicStatus}" Width="110" ElementStyle="{StaticResource CenterAligned}"/>
                            <DataGridTextColumn Header="{DynamicResource ColCurrentActivity}" Binding="{Binding CurrentActivityWithUnit}" Width="130" ElementStyle="{StaticResource CenterAligned}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Visibility="{Binding LowActivityAlertData.Count, Converter={StaticResource EqualityToVis}, ConverterParameter=0}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LabelNoDataAvailable}" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
