<UserControl x:Class="Sources.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Sources.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- ─── النمط الأساسي لأزرار التبويبات ─── -->
        <Style x:Key="SettingsTabButtonBase" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DataGridRowHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تبويب العام -->
        <Style x:Key="GeneralTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="General">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- تبويب المظهر -->
        <Style x:Key="AppearanceTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="Appearance">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- تبويب النسخ الاحتياطي -->
        <Style x:Key="BackupTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="Backup">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- تبويب إعدادات النظام -->
        <Style x:Key="SystemSettingsTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="SystemSettings">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="{StaticResource PrimaryColor}"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- تبويب الوضع الافتراضي (Factory Reset) -->
        <Style x:Key="FactoryResetTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="FactoryReset">
                    <Setter Property="Background" Value="#1AC25B4A"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.15" Color="#C25B4A"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- تبويب بيانات تجريبية (Debug Only) -->
        <Style x:Key="TestDataTabBtn" TargetType="Button" BasedOn="{StaticResource SettingsTabButtonBase}">
            <Setter Property="Foreground" Value="#D97706"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="TestData">
                    <Setter Property="Background" Value="#1AF59E0B"/>
                    <Setter Property="BorderBrush" Value="#D97706"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Foreground" Value="#D97706"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.15" Color="#D97706"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Stationary Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Tabs Bar -->
            <RowDefinition Height="*"/>    <!-- Row 2: Tab Content -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 1. شريط ترويسة الصفحة الموحد                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" Background="{DynamicResource CardBackground}"
                CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CogOutline" Width="34" Height="34"
                                             Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource SettingsSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 2. أزرار التبويبات الموحدة                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="0,0,0,16" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <!-- تبويب العام -->
                <Button Style="{StaticResource GeneralTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="General">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TabGeneral}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- تبويب المظهر -->
                <Button Style="{StaticResource AppearanceTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TabAppearance}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- تبويب النسخ الاحتياطي -->
                <Button Style="{StaticResource BackupTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="Backup">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudUploadOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TabBackup}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- تبويب إعدادات النظام -->
                <Button Style="{StaticResource SystemSettingsTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="SystemSettings">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TuneVerticalVariant" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TabSystemSettings}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- تبويب الوضع الافتراضي (للمدير فقط) -->
                <Button Style="{StaticResource FactoryResetTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="FactoryReset"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RestoreAlert" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TabFactoryReset}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- تبويب بيانات تجريبية (للمدير فقط و DEBUG فقط) -->
                <Button Style="{StaticResource TestDataTabBtn}"
                        Command="{Binding SelectTabCommand}" CommandParameter="TestData"
                        Visibility="{Binding CanShowTestData, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabasePlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="بيانات تجريبية (Debug)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 3. محتوى التبويبات القابل للتمرير                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="850" HorizontalAlignment="Center" Margin="0,0,0,24">

                <!-- ═══════ تبويب 1: العام ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="General">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- كارت اللغة -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Translate" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource LanguageTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource TitleLanguageChange}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <Button Content="العربية" Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding SetArabicCommand}" Margin="0,0,12,0" Padding="24,8"/>
                                <Button Content="English" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding SetEnglishCommand}" Padding="24,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- كارت معلومات النظام -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource SystemInfoTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- اسم المنظومة -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SystemInfoName}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,6,16,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="SOURCES - منظومة تتبع المصادر المشعة" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,6"/>

                                <!-- الإصدار -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SystemInfoVersion}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,6,16,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="1.0.0 (Release 2026)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,6"/>

                                <!-- المعيار الدولي -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SystemInfoStandard}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,6,16,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="IAEA Categorization of Radioactive Sources (RS-G-1.9)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,6"/>

                                <!-- محرك البيانات -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="قاعدة البيانات:" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,6,16,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="SQLite 3 (Local AppData Storage)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ تبويب 2: المظهر (Appearance) ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Appearance">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- كارت 1: وضع الواجهة (فاتح / داكن مع بطاقتي معاينة مصغرة) -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="Brightness6" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource AppearanceSectionThemeMode}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource AppearanceSectionThemeModeDesc}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- بطاقة المعاينة للوضع الفاتح -->
                                <Border Grid.Column="0" CornerRadius="10" Padding="16" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.16" Color="{StaticResource PrimaryColor}"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetLightModeCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- مصغر نافذة الوضع الفاتح -->
                                        <Border Height="110" CornerRadius="8" Background="#F7F5F1" BorderBrush="#E4DCD0" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- سايدبار مصغر -->
                                                <Border Grid.Column="0" Background="#123840" Padding="6">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.4" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.4" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- محتوى نافذة مصغر -->
                                                <Grid Grid.Column="1" Margin="8,6,8,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                        <Border Width="45" Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="4" BorderBrush="#E4DCD0" BorderThickness="1" Padding="4">
                                                            <StackPanel>
                                                                <Border Width="20" Height="4" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                <Border Width="30" Height="3" CornerRadius="1.5" Background="#A39C90" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="4" BorderBrush="#E4DCD0" BorderThickness="1" Padding="4">
                                                            <StackPanel>
                                                                <Border Width="16" Height="4" CornerRadius="2" Background="#3FAE7A" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#A39C90" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- عنوان وحالة الوضع الفاتح -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherSunny" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ThemeModeLightTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource ThemeModeLightDesc}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircle" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة المعاينة للوضع الداكن -->
                                <Border Grid.Column="2" CornerRadius="10" Padding="16" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.16" Color="{StaticResource PrimaryColor}"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetDarkModeCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- مصغر نافذة الوضع الداكن -->
                                        <Border Height="110" CornerRadius="8" Background="#17181B" BorderBrush="#34322D" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- سايدبار مصغر -->
                                                <Border Grid.Column="0" Background="#123840" Padding="6">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.4" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                        <Border Width="22" Height="4" CornerRadius="2" Background="#DCEEF0" Opacity="0.4" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- محتوى نافذة مصغر -->
                                                <Grid Grid.Column="1" Margin="8,6,8,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                        <Border Width="45" Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#202226" CornerRadius="4" BorderBrush="#34322D" BorderThickness="1" Padding="4">
                                                            <StackPanel>
                                                                <Border Width="20" Height="4" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                <Border Width="30" Height="3" CornerRadius="1.5" Background="#6E655A" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="#202226" CornerRadius="4" BorderBrush="#34322D" BorderThickness="1" Padding="4">
                                                            <StackPanel>
                                                                <Border Width="16" Height="4" CornerRadius="2" Background="#3FAE7A" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#6E655A" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- عنوان وحالة الوضع الداكن -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherNight" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource ThemeModeDarkTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource ThemeModeDarkDesc}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircle" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- كارت 2: لون التمييز (Accent Color) -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="Palette" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource AppearanceSectionAccentColor}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource AppearanceSectionAccentColorDesc}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

                            <!-- شبكة خيارات الألوان الأربعة -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. الأزرق البترولي (الافتراضي) -->
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="10" Padding="14,12" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#1F5A66">
                                                    <Setter Property="BorderBrush" Value="#1F5A66"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectAccentColorCommand}" CommandParameter="#1F5A66"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1F5A66" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#1F5A66">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource AccentColorPetroleumBlue}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Background="{DynamicResource DataGridRowSelected}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                    <TextBlock Text="{DynamicResource AccentColorDefaultBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource AccentColorPetroleumBlueDesc}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="#1F5A66" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2. الأزرق الملكي الداكن -->
                                <Border Grid.Row="0" Grid.Column="2" CornerRadius="10" Padding="14,12" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#1E3F66">
                                                    <Setter Property="BorderBrush" Value="#1E3F66"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectAccentColorCommand}" CommandParameter="#1E3F66"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1E3F66" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#1E3F66">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource AccentColorRoyalNavy}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{DynamicResource AccentColorRoyalNavyDesc}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="#1E3F66" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. الأخضر الغابي المطفي -->
                                <Border Grid.Row="2" Grid.Column="0" CornerRadius="10" Padding="14,12" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#3D5A47">
                                                    <Setter Property="BorderBrush" Value="#3D5A47"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectAccentColorCommand}" CommandParameter="#3D5A47"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#3D5A47" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#3D5A47">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource AccentColorForestGreen}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{DynamicResource AccentColorForestGreenDesc}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="#3D5A47" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 4. الرمادي الأردوازي -->
                                <Border Grid.Row="2" Grid.Column="2" CornerRadius="10" Padding="14,12" Cursor="Hand" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#433E52">
                                                    <Setter Property="BorderBrush" Value="#433E52"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectAccentColorCommand}" CommandParameter="#433E52"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#433E52" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAccentColor}" Value="#433E52">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource AccentColorSlate}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{DynamicResource AccentColorSlateDesc}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="#433E52" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ تبويب 3: النسخ الاحتياطي ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Backup">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- مكان حفظ النسخ -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="FolderOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource BackupLocationTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource BackupLocationDesc}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>
                            
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{DynamicResource BtnBrowse}" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding BrowseBackupPathCommand}" Margin="0,0,12,0"
                                        Padding="16,8"/>
                                <TextBox Text="{Binding BackupPath, Mode=TwoWay}" IsReadOnly="True"
                                         Style="{StaticResource FormTextBox}" 
                                         VerticalContentAlignment="Center" FontSize="13"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- النسخ التلقائي -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource AutoBackupTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource EnableAutoBackup}" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <ToggleButton DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="0,0,16,0"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding AutoBackupEnabled}"/>
                            </DockPanel>

                            <!-- تكرار النسخ (يظهر فقط عند التفعيل) -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource BackupFrequency}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <ComboBox SelectedValue="{Binding SelectedFrequency}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource FormComboBox}"
                                          Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="Daily" Content="{DynamicResource FreqDaily}" />
                                    <ComboBoxItem Tag="Weekly" Content="{DynamicResource FreqWeekly}" />
                                    <ComboBoxItem Tag="Monthly" Content="{DynamicResource FreqMonthly}" />
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- زر حفظ إعدادات النسخ -->
                            <Button Content="{DynamicResource BtnSaveSettings}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding SaveBackupSettingsCommand}" 
                                    Margin="0,20,0,0" HorizontalAlignment="Left" Padding="24,9"/>
                        </StackPanel>
                    </Border>

                    <!-- النسخ والاستعادة اليدوية -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="DatabaseSyncOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ManualBackupTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- آخر نسخة احتياطية -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" 
                                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Margin="0,0,10,0" 
                                                             Foreground="{DynamicResource PrimaryBrush}" Width="20" Height="20"/>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                        <Run Text="{DynamicResource LastBackupLabel}"/>
                                        <Run Text="{Binding LastBackupInfo}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding CreateBackupCommand}" Margin="0,0,12,0" Padding="20,10"
                                        Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseExport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource BtnCreateBackup}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RestoreBackupCommand}" Padding="20,10"
                                        Style="{StaticResource SecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseImport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource BtnRestoreBackup}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ تبويب 3: إعدادات النظام ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="SystemSettings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- عتبات التنبيهات الذكية -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="BellAlertOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource AlertSettingsTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="ضبط معايير مراقبة النشاط ودورية فحص التنبيهات الآلية" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

                            <!-- عتبة النشاط المنخفض -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource LabelLowActivityThreshold}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource DescLowActivityThreshold}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding LowActivityThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}" Width="200" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- دورية فحص التنبيهات -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource LabelNotificationCheckInterval}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource DescNotificationCheckInterval}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NotificationCheckIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}" Width="200" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- مهلة التنبيه بالاستعارات المستحقة -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource LabelDueSoonThreshold}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource DescDueSoonThreshold}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding DueSoonDaysThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}" Width="200" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- بيانات ترويسة التقارير والمؤسسة -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ReportHeaderSettingsTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="البيانات المعتمدة للمؤسسة والمعمل المعروضة في ترويسات ومستندات النظام" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

                            <!-- اسم المؤسسة -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource LabelFacilityName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FacilityName, Mode=TwoWay}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <!-- عنوان المنشأة -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource LabelFacilityAddress}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FacilityAddress, Mode=TwoWay}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <!-- المسؤول / المدير الفني -->
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource LabelTechnicalDirector}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding TechnicalDirector, Mode=TwoWay}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <!-- زر حفظ إعدادات النظام -->
                            <Button Content="{DynamicResource BtnSaveSystemSettings}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding SaveSystemSettingsCommand}" 
                                    HorizontalAlignment="Left" Padding="28,10">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource BtnSaveSystemSettings}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ تبويب 4: الوضع الافتراضي (Factory Reset) ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="FactoryReset">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- بطاقة التحذير البصري الشديد -->
                    <Border Background="#1AC25B4A" BorderBrush="#66C25B4A" BorderThickness="1.5"
                            CornerRadius="10" Padding="20,18" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AlertOctagonOutline" Width="36" Height="36"
                                                     Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource TitleFactoryResetWarning}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource MsgFactoryResetWarningDescription}" FontSize="13.5" LineHeight="22"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- المرحلة 1: كتابة جملة التأكيد -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="24,20" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Numeric1Circle" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LabelResetStep1}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- شارة الاجتياز -->
                                <Border Background="#1A3FAE7A" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                        Visibility="{Binding IsStage1Passed, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{DynamicResource SuccessBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="تم التحقق" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8">
                                <Run Text="{DynamicResource LabelTypePhrasePrompt}"/>
                                <Run Text=" «"/>
                                <Run Text="{DynamicResource PhraseFactoryResetConfirmation}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                <Run Text="»"/>
                            </TextBlock>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ResetPhrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsStage1Passed, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource FormTextBox}" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource BtnVerifyPhrase}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding VerifyResetPhraseCommand}"
                                        IsEnabled="{Binding IsStage1Passed, Converter={StaticResource InverseBoolConverter}}"
                                        Padding="20,10" Height="60"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- المرحلة 2: التحقق من كلمة المرور (تظهر فقط بعد اجتياز المرحلة 1) -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="24,20" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Visibility="{Binding IsStage1Passed, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Numeric2Circle" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LabelResetStep2}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- شارة الاجتياز -->
                                <Border Background="#1A3FAE7A" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                        Visibility="{Binding IsStage2Passed, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{DynamicResource SuccessBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="تم التحقق" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <TextBlock Text="{DynamicResource LabelEnterAdminPassword}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ResetPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsStage2Passed, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource FormTextBox}" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource BtnVerifyPassword}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding VerifyResetPasswordCommand}"
                                        IsEnabled="{Binding IsStage2Passed, Converter={StaticResource InverseBoolConverter}}"
                                        Padding="20,10" Height="60"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- المرحلة 3: التأكيد النهائي والتنفيذ (تظهر فقط بعد اجتياز المرحلتين 1 و 2) -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="24,20" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Visibility="{Binding IsStage2Passed, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="Numeric3Circle" Width="22" Height="22" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LabelResetStep3}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="{DynamicResource BtnExecuteFactoryReset}"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding ExecuteFactoryResetCommand}"
                                    HorizontalAlignment="Left" Padding="28,12" Height="48">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DeleteForever" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                                            <TextBlock Text="{DynamicResource BtnExecuteFactoryReset}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ تبويب 5: بيانات تجريبية (Debug Only) ═══════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="TestData">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                            Padding="24,20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="DatabasePlus" Width="24" Height="24" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="توليد بيانات تجريبية واقعية (Debug Mode)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="#12F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="تتيح هذه الأداة إنشاء حزمة متكاملة من البيانات التجريبية لاختبار شاشات وتقارير وتنبيهات المنظومة:" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• 20 موقعاً فعالاً تشمل مختبرات ومخازن ومستشفيات وعيادات بمسؤولين مختلفين." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,4"/>
                                    <TextBlock Text="• 300 مصدراً مشعاً بتوزيعات واقعية للنشاط الإشعاعي (أحادية ومتعددة النظائر)." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,4"/>
                                    <TextBlock Text="• 50 مصدراً مخصصاً لاختبار التنبيهات الذكية (25 تحذير + 25 حرج) بحسابات انحلال دقيقة." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,4"/>
                                    <TextBlock Text="• 100 طلب استعارة (70 مرتجع + 15 جاري التسليم + 10 متأخر Overdue + 5 قيد الاعتماد)." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,8"/>
                                    <TextBlock Text="⚠️ ملاحظة: هذه الميزة مخصصة لأغراض التطوير والاختبار (DEBUG) وتعمل داخل Transaction لضمان سلامة قاعدة البيانات." FontSize="12" Foreground="#D97706" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Button Content="توليد البيانات التجريبية الآن"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateTestDataCommand}"
                                    Background="#D97706" BorderBrush="#D97706"
                                    HorizontalAlignment="Left" Padding="28,12" Height="46">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseArrowUp" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                                            <TextBlock Text="توليد البيانات التجريبية الآن" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 4. مؤشر التحميل والعمليات الخلفية (Busy Overlay)        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#66000000" CornerRadius="12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" IsIndeterminate="True" Width="42" Height="42" 
                                 Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimary}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
