<UserControl x:Class="Sources.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource PageSubTitle}"/>
        </StackPanel>

        <TabControl Grid.Row="1" 
                    Background="Transparent" BorderThickness="0"
                    materialDesign:ColorZoneAssist.Mode="Standard">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="20,12"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#15000000"/> <!-- الخفيف جداً عند التمرير -->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ═══════ تبويب العام ═══════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <materialDesign:PackIcon Kind="CogOutline" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                        <TextBlock Text="{DynamicResource TabGeneral}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="8,16">
                    <StackPanel MaxWidth="600">


                        <!-- اللغة -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LanguageTitle}" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="العربية" Style="{StaticResource PrimaryButton}" Command="{Binding SetArabicCommand}" Margin="0,0,12,0"/>
                                    <Button Content="English" Style="{StaticResource SecondaryButton}" Command="{Binding SetEnglishCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- معلومات النظام -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SystemInfoTitle}" Style="{StaticResource CardTitle}"/>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                        <Run Text="{DynamicResource SystemInfoName}"/> <Run Text="Sources" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                        <Run Text="{DynamicResource SystemInfoVersion}"/> <Run Text="1.0.0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                        <Run Text="{DynamicResource SystemInfoStandard}"/> <Run Text="IAEA Radioactive Source Categorization" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- رسالة -->
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="8"
                                Visibility="{Binding HasGeneralMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding GeneralMessage}" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ تبويب النسخ الاحتياطي ═══════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <materialDesign:PackIcon Kind="CloudUploadOutline" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                        <TextBlock Text="{DynamicResource TabBackup}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Padding="8,16">
                    <StackPanel MaxWidth="600">

                        <!-- مكان حفظ النسخ -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource BackupLocationTitle}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{DynamicResource BackupLocationDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,12"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="{DynamicResource BtnBrowse}" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding BrowseBackupPathCommand}" Margin="0,0,12,0"
                                            Padding="16,8"/>
                                    <TextBox Text="{Binding BackupPath, Mode=TwoWay}" IsReadOnly="True"
                                             Style="{StaticResource FormTextBox}" 
                                             VerticalContentAlignment="Center" FontSize="13"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- النسخ التلقائي -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AutoBackupTitle}" Style="{StaticResource CardTitle}"/>
                                
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EnableAutoBackup}" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <ToggleButton DockPanel.Dock="Left" HorizontalAlignment="Left"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding AutoBackupEnabled}"/>
                                </DockPanel>

                                <!-- تكرار النسخ (يظهر فقط عند التفعيل) -->
                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource BackupFrequency}" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <ComboBox SelectedValue="{Binding SelectedFrequency}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FormComboBox}"
                                              Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Tag="Daily" Content="{DynamicResource FreqDaily}" />
                                        <ComboBoxItem Tag="Weekly" Content="{DynamicResource FreqWeekly}" />
                                        <ComboBoxItem Tag="Monthly" Content="{DynamicResource FreqMonthly}" />
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- زر حفظ الإعدادات -->
                                <Button Content="{DynamicResource BtnSaveSettings}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding SaveBackupSettingsCommand}" 
                                        Margin="0,16,0,0" HorizontalAlignment="Left" Padding="24,10"/>
                            </StackPanel>
                        </Border>

                        <!-- النسخ والاستعادة اليدوية -->
                        <Border Style="{StaticResource ContentCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ManualBackupTitle}" Style="{StaticResource CardTitle}"/>
                                
                                <!-- آخر نسخة -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                    <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource GoldBrush}"/>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="{DynamicResource LastBackupLabel}"/>
                                        <Run Text="{Binding LastBackupInfo}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding CreateBackupCommand}" Margin="0,0,12,0" Padding="20,10"
                                            Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseExport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource BtnCreateBackup}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RestoreBackupCommand}" Padding="20,10"
                                            Style="{StaticResource SecondaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseImport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource BtnRestoreBackup}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- رسالة حالة -->
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="8"
                                Visibility="{Binding HasBackupMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BackupMessage}" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
