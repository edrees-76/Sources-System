<Window x:Class="Sources.Views.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="شاشة التوقف | مصادر" Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#08101E">

    <Grid x:Name="RootGrid" Focusable="True">
        <!-- Opaque Navy Background -->
        <Border Background="#050A14" />

        <!-- Blurred Backdrop Background Image (Tajoura Nuclear Monument Ambient) -->
        <Image Source="pack://siteoforigin:,,,/Assets/sources_backdrop.jpg" Stretch="UniformToFill" Opacity="0.5">
            <Image.Effect>
                <BlurEffect Radius="35" RenderingBias="Quality" />
            </Image.Effect>
        </Image>
        
        <!-- Dark Tint & Radial Gradient Overlay -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#CC162A4A" Offset="0.0" />
                    <GradientStop Color="#E60B1320" Offset="0.65" />
                    <GradientStop Color="#F2050A14" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Center Screensaver Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
            
            <!-- Transparent 3D Shield Emblem (Enlarged 240x240 without white background circle) -->
            <Image Source="pack://siteoforigin:,,,/Assets/sources_shield_only.png"
                   Width="240" Height="240"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,25">
                <Image.Effect>
                    <DropShadowEffect Color="#D4AF37" BlurRadius="30" Direction="270" ShadowDepth="2" Opacity="0.45" />
                </Image.Effect>
            </Image>

            <!-- Main App Title -->
            <TextBlock Text="مــصــادر | SOURCES"
                       FontSize="38"
                       FontWeight="Bold"
                       Foreground="#D4AF37"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,16">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.75" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Complete Hierarchy Organization Text -->
            <TextBlock Text="مركـز البحـوث النوويـة - تاجوراء (TNRC)"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
                       
            <TextBlock Text="منظومة إدارة وتتبع المصادر والنظائر المشعة"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#7FC3E8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Bottom Action Hint -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60">
            <materialDesign:PackIcon Kind="CursorPointer" Width="28" Height="28" Foreground="#9FB2CC" HorizontalAlignment="Center" Margin="0,0,0,10">
                <materialDesign:PackIcon.RenderTransform>
                    <TranslateTransform x:Name="PointerTranslate" Y="0" />
                </materialDesign:PackIcon.RenderTransform>
                <materialDesign:PackIcon.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="PointerTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 From="0" To="-6" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </materialDesign:PackIcon.Triggers>
            </materialDesign:PackIcon>

            <TextBlock Text="اضغط أي زر أو حرّك المؤشر للمتابعة"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#9FB2CC"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
