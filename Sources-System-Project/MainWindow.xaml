<Window x:Class="Sources.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource AppTitleHeader}"
        WindowState="Maximized"
        MinWidth="1200" MinHeight="700"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <!-- الواجهة الرئيسية مع الشريط السفلي -->
        <DockPanel>

            <!-- ─── الشريط السفلي (Bottom Navigation) ─── -->
            <Border DockPanel.Dock="Bottom" x:Name="SidebarBorder"
                    Height="88"
                    Background="{StaticResource SidebarGradient}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    ClipToBounds="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="64" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="88" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- حاوية الشريط السفلي الكاملة -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── الشعار (درع مصادر + نص) ── -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,8,0">
                        <Image Source="pack://siteoforigin:,,,/Assets/sources_shield_only.png"
                               Width="32" Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource PrimaryLightColor}" Opacity="0.4"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="مصادر"
                                   Foreground="White"
                                   FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>

                    <!-- ── أزرار التنقل الأفقية ── -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False">
                        <UniformGrid Rows="1" VerticalAlignment="Center" Margin="0,6,0,0">

                            <!-- لوحة التحكم -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuDashboard}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- النظائر المشعة -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Radioisotopes"
                                    Visibility="{Binding CanSeeRadioisotopes, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Atom" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuRadioisotopes}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- المصادر المشعة -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Sources"
                                    Visibility="{Binding CanSeeSources, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Radioactive" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuSources}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- المواقع -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Locations"
                                    Visibility="{Binding CanSeeLocations, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MapMarker" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuLocations}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- استعارة المصادر -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Borrowing"
                                    Visibility="{Binding CanSeeBorrowing, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BookArrowRight" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuBorrowing}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- اختبارات التسرب الدوري (Leak Tests) -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="LeakTests"
                                    Visibility="{Binding CanSeeLeakTests, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuLeakTests}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>


                            <!-- التقارير -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Reports"
                                    Visibility="{Binding CanSeeReports, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileChart" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuReports}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- التنبيهات -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Alerts"
                                    Visibility="{Binding CanSeeAlerts, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BellRingOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuAlerts}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- المستخدمين -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Users"
                                    Visibility="{Binding CanSeeUsers, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuUsers}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- الحاسبة الإشعاعية -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="ActivityCalculator"
                                    Visibility="{Binding CanSeeCalculator, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Calculator" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuActivityCalculator}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- مكتبة النظائر المرجعية -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="IsotopeLibrary"
                                    Visibility="{Binding CanSeeIsotopeLibrary, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuIsotopeLibrary}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- المساعدة والدليل -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Help"
                                    Visibility="{Binding CanSeeHelp, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuHelp}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- الإعدادات -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                    Visibility="{Binding CanSeeSettings, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Cog" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuSettings}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>


                            <!-- حول المنظومة -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="AboutSystem">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MenuAbout}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- خروج -->
                            <Button Style="{StaticResource BottomNavItem}"
                                    Command="{Binding LogoutCommand}"
                                    Foreground="#EF4444">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Logout" Width="22" Height="22"
                                                             HorizontalAlignment="Center" Foreground="#EF4444"/>
                                    <TextBlock Text="{DynamicResource MenuLogout}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" LineHeight="13" FontSize="11"
                                               Margin="0,2,0,0"
                                               Foreground="#EF4444"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </ScrollViewer>

                    <!-- ── معلومات المستخدم + زر الطي ── -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,12,0">

                        <!-- اسم المستخدم ودوره (مخفي عند الطي) -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentUserRole}"
                                       Foreground="{DynamicResource SidebarForeground}"
                                       FontSize="10" HorizontalAlignment="Right" Opacity="0.9"/>
                        </StackPanel>

                        <!-- زر الطي/التوسيع -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                Foreground="{DynamicResource SidebarForeground}"
                                ToolTip="{DynamicResource ToolTipCollapseSidebar}">
                            <materialDesign:PackIcon Kind="Menu" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ─── المحتوى الرئيسي ─── -->
            <DockPanel Background="{DynamicResource MainBackground}">
                <!-- ترويسة المحتوى مع جرس التنبيهات -->
                <Grid DockPanel.Dock="Top" Margin="24,24,24,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentViewName, Converter={StaticResource ViewNameToTitle}}"
                                 Style="{StaticResource PageTitle}"
                                 VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <!-- ترويسة المحتوى: الجرس ومعلومات المستخدم -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- جرس التنبيهات (يظهر فقط في شاشة لوحة القيادة Dashboard) -->
                        <materialDesign:PopupBox Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}"
                                               PlacementMode="BottomAndAlignRightEdges"
                                               ToolTip="{DynamicResource ToolTipNotifications}"
                                               Margin="0,0,16,0"
                                               Visibility="{Binding CurrentViewName, Converter={StaticResource EqualityToVis}, ConverterParameter=Dashboard}">
                            <materialDesign:PopupBox.ToggleContent>
                                <Grid>
                                    <materialDesign:PackIcon Kind="Bell" Width="24" Height="24" Foreground="{DynamicResource TextSecondary}"/>
                                    <Border Background="#EF4444" CornerRadius="10" Width="18" Height="18"
                                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-8,-8,0"
                                            Visibility="{Binding UnreadNotificationsCount, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding UnreadNotificationsCount}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </materialDesign:PopupBox.ToggleContent>


                            <Border Width="380" MinHeight="100" Background="{DynamicResource CardBackground}" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                                    materialDesign:ElevationAssist.Elevation="Dp3">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BellRing" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource TitleNotifications}" Foreground="White" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="White"
                                                    Content="{DynamicResource BtnMarkAllRead}" Command="{Binding MarkAllNotificationsAsReadCommand}"
                                                    Padding="8,0" Height="28" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer MinHeight="50" MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                             <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor}" Padding="14,12"
                                                            Background="{Binding IsRead, Converter={StaticResource BoolToValue}, ConverterParameter=Transparent|#151F5A66}"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.MarkNotificationAsReadCommand, RelativeSource={RelativeSource AncestorType=materialDesign:PopupBox}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon Kind="AlertCircle" Width="22" Height="22"
                                                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextPrimary}" FontSize="13" LineHeight="17"/>
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat=G}"
                                                                           Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,4,0,0" Opacity="0.8"/>
                                                            </StackPanel>

                                                            <!-- Unread Indicator Dot -->
                                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource PrimaryLightBrush}"
                                                                     VerticalAlignment="Center" Margin="6,0,4,0"
                                                                     Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVis}}"/>

                                                            <!-- Dismiss Button -->
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                                    Padding="2" Height="26" Width="26" Margin="2,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                    ToolTip="{DynamicResource ToolTipDismissAlert}"
                                                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=materialDesign:PopupBox}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>

                <ContentControl Content="{Binding CurrentView}"/>
            </DockPanel>
        </DockPanel>

        <!-- ══ Welcome Overlay ══ -->
        <Grid x:Name="WelcomeOverlay" Visibility="Collapsed" Panel.ZIndex="999">
            <!-- خلفية شفافة داكنة -->
            <Border Background="#88000000"/>
            <!-- البطاقة المركزية -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="20" Padding="48,36"
                    MinWidth="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.35" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- شعار المنظومة -->
                    <Border Width="80" Height="80" CornerRadius="40" 
                            Background="Transparent"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Image Source="pack://siteoforigin:,,,/Assets/sources_logo.png" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <!-- أيقونة الترحيب -->
                    <materialDesign:PackIcon Kind="HandWave" Width="36" Height="36"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <!-- نص الترحيب الرئيسي -->
                    <TextBlock x:Name="TxtWelcomeOverlay"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <!-- اسم المنظومة -->
                    <TextBlock Text="{DynamicResource SplashSystemTitle}"
                               FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
