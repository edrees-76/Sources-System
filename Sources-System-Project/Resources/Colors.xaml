<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── الألوان الأساسية — منظومة مصادر Sources (أزرق بترولي دافئ) ─── -->
    <Color x:Key="PrimaryColor">#1F5A66</Color>
    <Color x:Key="PrimaryLightColor">#3D7C89</Color>
    <Color x:Key="PrimaryDarkColor">#123840</Color>
    <Color x:Key="SecondaryColor">#1F5A66</Color>
    <Color x:Key="GoldColor">#1F5A66</Color>
    <Color x:Key="GoldLightColor">#3D7C89</Color>
    <Color x:Key="GoldDarkColor">#123840</Color>
    <Color x:Key="AccentColor">#1F5A66</Color>

    <!-- ─── لون مُستخرج من الجواهر والرسوم (تراكوتا دافئ) ─── -->
    <Color x:Key="GemBlueColor">#C97A4A</Color>
    <Color x:Key="GemBlueDarkColor">#A25C34</Color>

    <!-- ─── ألوان الحالات ─── -->
    <Color x:Key="SuccessColor">#3FAE7A</Color>
    <Color x:Key="WarningColor">#E0A93E</Color>
    <Color x:Key="DangerColor">#C25B4A</Color>
    <Color x:Key="InfoColor">#4F7FA3</Color>
    
    <!-- ─── التدرج الأساسي والفرش ─── -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="GemBlueBrush" Color="{StaticResource GemBlueColor}"/>
    <SolidColorBrush x:Key="GemBlueDarkBrush" Color="{StaticResource GemBlueDarkColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- ─── تدرج لوني ─── -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- HeroGradient (135 deg: #EFEAE0 -> #F7E6DC -> #E9EEF2) -->
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFEAE0" Offset="0"/>
        <GradientStop Color="#F7E6DC" Offset="0.5"/>
        <GradientStop Color="#E9EEF2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#123840" Offset="0"/>
        <GradientStop Color="#1A4B54" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
