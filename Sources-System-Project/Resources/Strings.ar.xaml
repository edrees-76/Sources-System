    <!-- About System -->
    <system:String x:Key="AboutTitle">عن المنظومة والمُصمم</system:String>
    <system:String x:Key="AboutSystemTitle">عن منظومة مصادر (Sources)</system:String>
    <system:String x:Key="AboutSystemDesc">مصادر هي حل برمجي ذكي ومتكامل يهدف إلى الرقابة الصارمة والتتبع الدقيق للمصادر والنظائر المشعة. توفر المنظومة أدوات متقدمة لحساب النشاط الإشعاعي، إدارة حركة المصادر، وربطها بالمستخدمين والمواقع.</system:String>
    <system:String x:Key="AboutCapabilitiesTitle">المميزات التقنية</system:String>
    <system:String x:Key="AboutCapabilities1">• واجهة مستخدم حديثة وتفاعلية بدعم الوضعين الداكن والفاتح.</system:String>
    <system:String x:Key="AboutCapabilities2">• نظام إدارة قواعد بيانات آمن وموثوق للحفظ والاسترجاع.</system:String>
    <system:String x:Key="AboutCapabilities3">• واجهة ثنائية اللغة (عربي/إنجليزي) تتيح التبديل الفوري.</system:String>
    <system:String x:Key="AboutCapabilities4">• حاسبة مدمجة للنشاط الإشعاعي بناءً على قوانين التحلل.</system:String>
    <system:String x:Key="AboutFeaturesTitle">إمكانيات الإدارة</system:String>
    <system:String x:Key="AboutFeatures1">• تتبع شامل لحركة جميع المصادر وربطها بالعهد.</system:String>
    <system:String x:Key="AboutFeatures2">• استخراج وتصدير التقارير الإحصائية بصيغ PDF و Excel.</system:String>
    <system:String x:Key="AboutFeatures3">• إدارة المستخدمين بصلاحيات وأدوار مخصصة.</system:String>
    <system:String x:Key="AboutFeatures4">• نظام تنبيهات مبكر للمصادر منتهية الصلاحية.</system:String>
    <system:String x:Key="AboutDesignerTitle">معلومات المُصمم والمطور</system:String>
    <system:String x:Key="AboutRights">جميع الحقوق محفوظة © 2026 مصادر</system:String>
    <system:String x:Key="AboutSidebarDesc">تم التصميم ليتوافق مع متطلبات الرقابة الإشعاعية ويعمل بكفاءة عالية على أجهزة الكمبيوتر دون الحاجة لموارد كبيرة.</system:String>

