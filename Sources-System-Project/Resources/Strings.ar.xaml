    <system:String x:Key="AboutStandardIaeaDesc">IAEA Categorization of Radioactive Sources (RS-G-1.9)</system:String>
    <system:String x:Key="AboutDatabaseEngineTitle">محرك قاعدة البيانات</system:String>
    <system:String x:Key="AboutDatabaseEngineDesc">SQLite 3 (محلي مشفر ومستقل للبيانات الحساسة)</system:String>
    <system:String x:Key="AboutFrameworkTitle">البيئة والتقنية</system:String>
