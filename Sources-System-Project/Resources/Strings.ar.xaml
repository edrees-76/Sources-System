    <!-- About System -->
    <system:String x:Key="AboutTitle">عن المنظومة</system:String>
    <system:String x:Key="AboutSystemTitle">عن منظومة مصادر (Sources)</system:String>
    <system:String x:Key="AboutSystemDesc">مصادر هي حل برمجي ذكي ومتكامل يهدف إلى الرقابة الصارمة والتتبع الدقيق للمصادر والنظائر المشعة. توفر المنظومة أدوات متقدمة لحساب النشاط الإشعاعي، إدارة حركة المصادر، وربطها بالمستخدمين والمواقع.</system:String>

    <!-- Header &amp; Mission -->
    <system:String x:Key="AboutHeaderTitle">منظومة مصادر — Sources System</system:String>
    <system:String x:Key="AboutHeaderSubtitle">المنظومة المتكاملة للرقابة الصارمة وتتبع المصادر والنظائر المشعة</system:String>
    <system:String x:Key="AboutHeaderTagline">الأمان الإشعاعي • الرقابة المؤسسية • الحسابات النووية الدقيقة</system:String>
    <system:String x:Key="AboutMissionTitle">الرسالة والغاية التشغيلية</system:String>
    <system:String x:Key="AboutMissionText">صُممت منظومة مصادر لتوفير رقابة إشعاعية صارمة وموثوقية عالية في تتبع وحصر حركة المصادر والنظائر المشعة في البيئات البحثية والمؤسسية، بما يضمن أعلى معايير السلامة والأمان وسرعة اتخاذ القرار وتوثيق المعاملات الإشعاعية بدقة متناهية.</system:String>

