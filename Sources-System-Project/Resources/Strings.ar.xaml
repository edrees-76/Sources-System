    <!-- Core Capabilities -->
    <system:String x:Key="AboutCapabilitiesHeader">أبرز القدرات الوظيفية للمنظومة</system:String>
    <system:String x:Key="AboutCap1Title">تتبع التحلل والنشاط الإشعاعي</system:String>
    <system:String x:Key="AboutCap1Desc">حساب فوري لتلاشي النشاط الإشعاعي وفق قانون التحلل الأسي وعمر النصف الدقيق لكل نظير.</system:String>
    <system:String x:Key="AboutCap2Title">نظام التنبيهات الذكي وعمر النصف</system:String>
    <system:String x:Key="AboutCap2Desc">مراقبة آلية واستباقية للمصادر المنتهية، العهد المعارة المتأخرة، وتجاوز حدود النشاط الحرجة.</system:String>
    <system:String x:Key="AboutCap3Title">النسخ الاحتياطي والتعافي التلقائي</system:String>
    <system:String x:Key="AboutCap3Desc">جدولة ذكية للنسخ الاحتياطي وتدوير تلقائي للملفات مع إمكانية استعادة فورية بضغطة واحدة.</system:String>
    <system:String x:Key="AboutCap4Title">إدارة المستخدمين وسجل التدقيق</system:String>
    <system:String x:Key="AboutCap4Desc">تحكم محكم في الصلاحيات والأدوار مع توثيق زمني شامل لكل عملية إدخال أو تعديل أو استعارة.</system:String>

