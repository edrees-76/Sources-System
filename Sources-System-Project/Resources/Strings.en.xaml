    <!-- About System -->
    <system:String x:Key="AboutTitle">About System &#38; Designer</system:String>
    <system:String x:Key="AboutSystemTitle">About Sources System</system:String>
    <system:String x:Key="AboutSystemDesc">Sources is a smart, integrated software solution aimed at strict control and precise tracking of radioactive sources and isotopes. The system provides advanced tools for calculating radioactivity, managing the movement of sources, and linking them to users and locations.</system:String>
    <system:String x:Key="AboutCapabilitiesTitle">Technical Capabilities</system:String>
    <system:String x:Key="AboutCapabilities1">• Modern, interactive UI with Full Dark/Light mode support.</system:String>
    <system:String x:Key="AboutCapabilities2">• Secure and reliable database management system for storage and retrieval.</system:String>
    <system:String x:Key="AboutCapabilities3">• Bilingual interface (Arabic/English) allowing instant switching.</system:String>
    <system:String x:Key="AboutCapabilities4">• Built-in radioactivity calculator based on decay laws.</system:String>
    <system:String x:Key="AboutFeaturesTitle">Management Features</system:String>
    <system:String x:Key="AboutFeatures1">• Comprehensive tracking of movement for all sources.</system:String>
    <system:String x:Key="AboutFeatures2">• Extract and export statistical reports in PDF and Excel formats.</system:String>
    <system:String x:Key="AboutFeatures3">• User management with custom roles and permissions.</system:String>
    <system:String x:Key="AboutFeatures4">• Early warning system for expired sources.</system:String>
    <system:String x:Key="AboutDesignerTitle">Designer &#38; Developer Info</system:String>
    <system:String x:Key="AboutRights">All Rights Reserved © 2026 Sources</system:String>
    <system:String x:Key="AboutSidebarDesc">Designed to comply with radiation control requirements and operate highly efficiently on computers without needing heavy resources.</system:String>

