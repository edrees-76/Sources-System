    <!-- About System -->
    <system:String x:Key="AboutTitle">About System</system:String>
    <system:String x:Key="AboutSystemTitle">About Sources System</system:String>
    <system:String x:Key="AboutSystemDesc">Sources is a smart, integrated software solution aimed at strict control and precise tracking of radioactive sources and isotopes. The system provides advanced tools for calculating radioactivity, managing the movement of sources, and linking them to users and locations.</system:String>

    <!-- Header &amp; Mission -->
    <system:String x:Key="AboutHeaderTitle">Sources System — منظومة مصادر</system:String>
    <system:String x:Key="AboutHeaderSubtitle">Integrated System for Strict Control &amp; Precision Tracking of Radioactive Sources &amp; Isotopes</system:String>
    <system:String x:Key="AboutHeaderTagline">Radiation Safety • Institutional Control • Precision Nuclear Calculations</system:String>
    <system:String x:Key="AboutMissionTitle">Operational Mission &amp; Purpose</system:String>
    <system:String x:Key="AboutMissionText">Sources System is engineered to deliver strict radiation control and high reliability in tracking and managing radioactive sources and isotopes across research and institutional environments, ensuring compliance with the highest safety standards and instant decision-making capabilities.</system:String>

    <!-- Compliance &amp; Tech Specs -->
    <system:String x:Key="AboutComplianceTitle">Compliance Standards &amp; Technical Specifications</system:String>
    <system:String x:Key="AboutStandardIaeaTitle">International Safety Standard</system:String>
    <system:String x:Key="AboutStandardIaeaDesc">IAEA Categorization of Radioactive Sources (RS-G-1.9)</system:String>
    <system:String x:Key="AboutDatabaseEngineTitle">Database Engine</system:String>
    <system:String x:Key="AboutDatabaseEngineDesc">SQLite 3 (Encrypted &amp; Isolated Local Storage for Sensitive Data)</system:String>
    <system:String x:Key="AboutFrameworkTitle">Platform &amp; Framework</system:String>
    <system:String x:Key="AboutFrameworkDesc">WPF / .NET 8 (High-Stability Windows Desktop Architecture)</system:String>
    <system:String x:Key="AboutReleaseYearTitle">Release Year &amp; Status</system:String>
    <system:String x:Key="AboutReleaseYearDesc">2026 (Certified Stable Release)</system:String>

    <!-- Core Capabilities -->
    <system:String x:Key="AboutCapabilitiesHeader">Core System Capabilities</system:String>
    <system:String x:Key="AboutCap1Title">Radioactive Decay &amp; Activity Tracking</system:String>
    <system:String x:Key="AboutCap1Desc">Instant radioactivity decay computation based on exponential decay laws and isotope half-lives.</system:String>
    <system:String x:Key="AboutCap2Title">Smart Half-Life &amp; Overdue Alerts</system:String>
    <system:String x:Key="AboutCap2Desc">Automated proactive monitoring for expiring sources, overdue loans, and critical activity thresholds.</system:String>
    <system:String x:Key="AboutCap3Title">Automated Backup &amp; Recovery</system:String>
    <system:String x:Key="AboutCap3Desc">Intelligent snapshot scheduling, automatic file rotation, and one-click database restore.</system:String>
    <system:String x:Key="AboutCap4Title">User Permissions &amp; Full Audit Trail</system:String>
    <system:String x:Key="AboutCap4Desc">Strict role-based access control with comprehensive chronological logging for all operations.</system:String>

    <!-- Beneficiary (TNRC) -->
    <system:String x:Key="AboutBeneficiaryTitle">Beneficiary Institution</system:String>
    <system:String x:Key="AboutBeneficiaryOrgName">Tajoura Nuclear Research Center (TNRC)</system:String>
    <system:String x:Key="AboutBeneficiaryOrgEn">TNRC | Tajoura Nuclear Research Center — Libya</system:String>
    <system:String x:Key="AboutBeneficiaryDesc">The system was specifically engineered to meet field radiation control and radioactive isotope management requirements at Tajoura Nuclear Research Center, ensuring the highest standards of radiological safety and institutional governance.</system:String>

