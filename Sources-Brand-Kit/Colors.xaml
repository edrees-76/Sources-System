<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── الألوان الأساسية — منظومة مصادر Sources (كحلي وذهبي مع لمسة زرقاء فاتحة من الشعار) ─── -->
    <Color x:Key="PrimaryColor">#0B1320</Color> <!-- Navy Blue -->
    <Color x:Key="PrimaryLightColor">#1A2844</Color>
    <Color x:Key="PrimaryDarkColor">#080E18</Color>
    <Color x:Key="SecondaryColor">#D4AF37</Color> <!-- Gold -->
    <Color x:Key="GoldColor">#D4AF37</Color>
    <Color x:Key="GoldLightColor">#FFF5D1</Color>
    <Color x:Key="GoldDarkColor">#C5A059</Color>
    <Color x:Key="AccentColor">#D4AF37</Color>

    <!-- ─── لون مُستخرج من الجواهر الزرقاء في شعار مصادر — لاستخدامه كلون مميز ثالث (شارات، رسوم بيانية) ─── -->
    <Color x:Key="GemBlueColor">#7FC3E8</Color>
    <Color x:Key="GemBlueDarkColor">#4A90B8</Color>

    <!-- ─── ألوان الحالات ─── -->
    <Color x:Key="SuccessColor">#10B981</Color> <!-- Emerald -->
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    
    <!-- ─── التدرج الأساسي ─── -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="GemBlueBrush" Color="{StaticResource GemBlueColor}"/>
    <SolidColorBrush x:Key="GemBlueDarkBrush" Color="{StaticResource GemBlueDarkColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- ─── تدرج لوني ─── -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F2744" Offset="0"/>
        <GradientStop Color="#1C3E6E" Offset="0.5"/>
        <GradientStop Color="#2A5A9E" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
