<Window x:Class="Sources.AutoRun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sources System"
        Icon="pack://application:,,,/Assets/sources_icon.ico"
        Width="720" Height="690"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NavyBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="32,16,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط علوي: تبديل اللغة -->
        <Button x:Name="LanguageButton" Grid.Row="0" Style="{StaticResource OutlineButton}"
                HorizontalAlignment="Right" Height="34" MinWidth="96" FontSize="13"
                AutomationProperties.AutomationId="LanguageToggle"
                Click="LanguageButton_Click"/>

        <!-- الشعار والعنوان -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,20">
            <Image x:Name="LogoImage" Width="150" Height="150" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource GoldBrush}" FontSize="13"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2">

            <!-- تثبيت المنظومة -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="InstallTitleText" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InstallDescText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,4,12,0"/>
                    </StackPanel>
                    <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.AutomationId="InstallButton" Click="InstallButton_Click"/>
                </Grid>
            </Border>

            <!-- دليل الاستخدام -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="GuideTitleText" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GuideDescText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,4,12,0"/>
                    </StackPanel>
                    <Button x:Name="GuideButton" Grid.Column="1" Style="{StaticResource OutlineButton}"
                            AutomationProperties.AutomationId="GuideButton" Click="GuideButton_Click"/>
                </Grid>
            </Border>

            <!-- رقم التفعيل -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="ActivationTitleText" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActivationDescText" Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- الرقم دائماً من اليسار لليمين حتى في الواجهة العربية -->
                        <TextBox x:Name="ActivationBox" IsReadOnly="True" FlowDirection="LeftToRight"
                                 FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                 Background="{StaticResource NavyBrush}" Foreground="{StaticResource GoldBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                 Padding="12,0" Height="42" VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="ActivationCode"/>
                        <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" MinWidth="100"
                                AutomationProperties.AutomationId="CopyButton" Click="CopyButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- شريط الحالة -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource SuccessBrush}" FontSize="13"
                   TextWrapping="Wrap" MinHeight="20" HorizontalAlignment="Center"/>
    </Grid>
</Window>
